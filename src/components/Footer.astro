---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <div class="footer-col brand-col">
        <h3 class="footer-title">My Literary Journey</h3>
        <p class="footer-desc">
          A personal digital portfolio created by <strong>Crisler Annilov B. Padrinao</strong>, documenting reading reflections, literary analyses, and thematic insights across world classics in the Great Books course.
        </p>
      </div>

      <div class="footer-col">
        <h4 class="col-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/profile">Student Profile</a></li>
          <li><a href="/analyses">Literary Analyses</a></li>
          <li><a href="/favorite">Favorite Masterpiece</a></li>
          <li><a href="/reflection">Reflection & Summary</a></li>
          <li><a href="/credits">Credits & Sources</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="col-heading">Colophon & Citation</h4>
        <p class="integrity-text">
          All literary analyses, reflections, and original insights reflect personal academic inquiry. References to translations, historical sources, and critical lenses are credited accordingly.
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copy-text">
        &copy; {currentYear} &bull; <strong>My Literary Journey</strong> &bull; Crisler Annilov B. Padrinao &bull; All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 20;
    background: #ffffff;
    color: var(--color-text);
    border-top: 1px solid var(--color-border);
    margin-top: 0;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .footer-desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
    margin-bottom: 0;
  }

  .col-heading {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .integrity-text {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    background: var(--color-bg-alt);
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    margin: 0;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .copy-text strong {
    color: var(--color-primary);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
