---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "My Literary Journey | Great Books Portfolio",
  description = "A personal digital portfolio showcasing literary reflections, analyses, and insights throughout the Great Books journey."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Refined Literary Headings: Playfair Display (600 Semi-Bold) & Lora (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* Warm, Classic, Bookish Editorial Palette - Zero AI Gradients */
    --color-bg: #fbfaf7;            /* Warm book paper / off-white */
    --color-bg-alt: #f3f1ec;        /* Linen / light kraft tone */
    --color-card-bg: #ffffff;       /* Clean white surface */
    --color-primary: #110e0c;       /* Deep rich book-press ink (thick & bold) */
    --color-primary-soft: #292524;
    --color-accent: #881337;        /* Classic book cloth oxblood / crimson */
    --color-accent-soft: #9f1239;
    --color-warm-brown: #78350f;    /* Vintage leather brown */
    --color-gold: #d97706;          /* Antique gold foil */
    --color-border: #e7e5df;        /* Book edge / paper border */
    --color-border-dark: #d6d3cd;
    --color-text: #292524;          /* Soft charcoal ink */
    --color-text-muted: #6b645f;    /* Subdued editorial grey */
    --color-text-light: #a8a29e;
    
    /* Authentic Bookish Typography: Playfair Display (Thick Bold Headings) & Lora (Body) */
    --font-heading: 'Playfair Display', Georgia, Cambria, serif;
    --font-serif: 'Playfair Display', Georgia, Cambria, serif;
    --font-sans: 'Lora', Georgia, Cambria, serif;
    --font-body: 'Lora', Georgia, Cambria, serif;
    
    /* Soft natural book shadows */
    --shadow-sm: 0 1px 2px rgba(41, 37, 36, 0.04);
    --shadow-md: 0 4px 12px rgba(41, 37, 36, 0.05);
    --shadow-lg: 0 10px 24px rgba(41, 37, 36, 0.07);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    font-family: var(--font-body);
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.75;
    font-size: 16px;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg);
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
  }

  #main-content {
    flex: 1 0 auto;
  }

  .container {
    width: 100%;
    max-width: 1160px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .container-reading {
    width: 100%;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  /* Headings: Deep Ink, Elegant Semi-Bold Stems (Weight 600) */
  h1, h2, h3, h4, h5, h6 {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.25;
    margin-top: 0;
    letter-spacing: -0.015em;
  }

  h1 { font-size: 2.9rem; font-weight: 600; }
  h2 { font-size: 2.25rem; font-weight: 600; }
  h3 { font-size: 1.65rem; font-weight: 600; }
  h4 { font-size: 1.25rem; font-weight: 600; }

  /* Editorial Tag */
  .tag {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    font-size: 0.82rem;
    font-family: var(--font-body);
    font-weight: 500;
    border-radius: 3px;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  .tag-accent {
    background: #fff1f2;
    color: var(--color-accent);
    border-color: #fecdd3;
  }

  /* Universal Subpage Header */
  .page-header-block {
    padding: 4rem 0 3rem;
    text-align: center;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .page-header-block .section-tag {
    font-size: 0.82rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-header-block h1 {
    font-size: 3.1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .page-header-block .lead-text {
    max-width: 660px;
    margin: 0 auto;
    font-size: 1.08rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .page-header-block h1 {
      font-size: 2.35rem;
    }
  }
</style>
