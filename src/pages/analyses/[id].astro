---
import Layout from '../../layouts/Layout.astro';
import { analyses, type LiteraryAnalysis } from '../../data/analyses';

export function getStaticPaths() {
  return analyses.map((item) => ({
    params: { id: item.id },
    props: { item }
  }));
}

interface Props {
  item: LiteraryAnalysis;
}

const { item } = Astro.props;

const currentIndex = analyses.findIndex(a => a.id === item.id);
const prevAnalysis = currentIndex > 0 ? analyses[currentIndex - 1] : null;
const nextAnalysis = currentIndex < analyses.length - 1 ? analyses[currentIndex + 1] : null;
---

<Layout 
  title={`${item.title} - Literary Analysis | Great Books`}
  description={`Literary analysis of ${item.title} by ${item.author} using ${item.lens}.`}
>
  <!-- Top Bar -->
  <div class="analysis-reader-topbar">
    <div class="container container-reading topbar-inner">
      <a href="/analyses" class="back-link">
        &larr; Back to Literary Analyses
      </a>
      <span class="tag tag-accent">{item.lens.split('/')[0]}</span>
    </div>
  </div>

  <article class="container container-reading analysis-article">
    <!-- Header -->
    <header class="article-header">
      <div class="article-period-tag">{item.period}</div>
      <h1 class="article-title">{item.title}</h1>
      <div class="article-author">
        Author: <strong>{item.author}</strong>
      </div>

      <!-- Critical Approach Card -->
      <div class="lens-highlight-card">
        <div class="lens-card-header">
          <span class="lens-label">Critical Lens:</span>
          <span class="lens-name">{item.lens}</span>
        </div>
        <p class="lens-desc">{item.lensDefinition}</p>
      </div>
    </header>

    <!-- Visual Representation Frame (Clean bookish frame, zero AI gradients) -->
    <div class="visual-representation-box">
      <div class="visual-canvas">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="canvas-icon">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
        <span class="canvas-tag">Visual Artifact & Symbol</span>
      </div>
      <div class="visual-meta">
        <span class="meta-label">Description:</span>
        <p class="meta-text">{item.visualDescription}</p>
      </div>
    </div>

    <!-- The Literary Analysis Body -->
    <div class="analysis-body-sections">
      <section class="analysis-subblock">
        <h3 class="subblock-heading">1. Introduction & Context</h3>
        <p class="subblock-text">{item.fullAnalysis.introduction}</p>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">2. Application of Critical Lens</h3>
        <p class="subblock-text">{item.fullAnalysis.lensApplication}</p>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">3. Textual Evidence & Interpretation</h3>
        <p class="subblock-text">{item.fullAnalysis.textualEvidence}</p>
        
        <div class="key-themes-pill-list">
          <span class="pill-label">Key Themes:</span>
          {item.keyThemes.map((theme) => (
            <span class="theme-tag">{theme}</span>
          ))}
        </div>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">4. Conclusion & Synthesis</h3>
        <p class="subblock-text">{item.fullAnalysis.conclusion}</p>
      </section>
    </div>

    <!-- Navigation between analyses -->
    <nav class="analysis-pagination">
      {prevAnalysis ? (
        <a href={`/analyses/${prevAnalysis.id}`} class="pagination-btn prev-btn">
          <span class="direction">&larr; Previous</span>
          <span class="work-name">{prevAnalysis.title}</span>
        </a>
      ) : (
        <div class="pagination-placeholder"></div>
      )}

      {nextAnalysis ? (
        <a href={`/analyses/${nextAnalysis.id}`} class="pagination-btn next-btn">
          <span class="direction">Next &rarr;</span>
          <span class="work-name">{nextAnalysis.title}</span>
        </a>
      ) : (
        <a href="/favorite" class="pagination-btn next-btn complete-btn">
          <span class="direction">Continue to &rarr;</span>
          <span class="work-name">Favorite Masterpiece</span>
        </a>
      )}
    </nav>
  </article>
</Layout>

<style>
  .analysis-reader-topbar {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .analysis-article {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }

  .article-period-tag {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .article-title {
    font-size: 2.4rem;
    margin-bottom: 0.5rem;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .article-author {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .article-author strong {
    color: var(--color-primary);
  }

  .lens-highlight-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
  }

  .lens-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .lens-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lens-name {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-primary);
  }

  .lens-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Visual Box */
  .visual-representation-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2.75rem;
  }

  .visual-canvas {
    background: var(--color-bg);
    color: var(--color-text);
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .canvas-icon {
    color: var(--color-warm-brown);
  }

  .canvas-tag {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .visual-meta {
    padding: 1rem 1.25rem;
    background: #ffffff;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.88rem;
  }

  .meta-label {
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .meta-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Body */
  .analysis-body-sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .analysis-subblock {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem;
  }

  .subblock-heading {
    font-size: 1.25rem;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .subblock-text {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }

  .key-themes-pill-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .pill-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .theme-tag {
    font-size: 0.78rem;
    background: var(--color-bg);
    color: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  /* Pagination */
  .analysis-pagination {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .pagination-btn {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
    min-width: 200px;
  }

  .pagination-btn:hover {
    border-color: var(--color-accent);
  }

  .direction {
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .work-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .next-btn {
    text-align: right;
    margin-left: auto;
  }

  @media (max-width: 680px) {
    .article-title {
      font-size: 1.9rem;
    }

    .analysis-subblock {
      padding: 1.5rem;
    }

    .visual-meta {
      flex-direction: column;
      gap: 0.25rem;
    }

    .pagination-btn {
      width: 100%;
      text-align: left;
    }

    .next-btn {
      text-align: left;
    }
  }
</style>
