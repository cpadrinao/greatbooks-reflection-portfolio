---
import Layout from '../../layouts/Layout.astro';
import { analyses, type LiteraryAnalysis } from '../../data/analyses';

export function getStaticPaths() {
  return analyses.map((item) => ({
    params: { id: item.id },
    props: { item }
  }));
}

interface Props {
  item: LiteraryAnalysis;
}

const { item } = Astro.props;

const currentIndex = analyses.findIndex(a => a.id === item.id);
const prevAnalysis = currentIndex > 0 ? analyses[currentIndex - 1] : null;
const nextAnalysis = currentIndex < analyses.length - 1 ? analyses[currentIndex + 1] : null;
---

<Layout 
  title={`${item.title} - Literary Analysis | Great Books`}
  description={`Literary analysis of ${item.title} by ${item.author} using ${item.lens}.`}
>
  <div class="analysis-stage-wrapper">
    <!-- Full-Bleed Ambient Pixel Landscape Stage (Strictly Contained Above Footer) -->
    <div class="full-bleed-pixel-stage" style={`background-image: url('${item.pixelBg}');`} aria-hidden="true"></div>

    <!-- Top Bar -->
    <div class="analysis-reader-topbar">
      <div class="container container-reading topbar-inner">
        <a href="/analyses" class="back-link">
          &larr; Back to Literary Analyses
        </a>
        <span class="tag tag-accent">{item.lens}</span>
      </div>
    </div>

    <article class="container container-reading analysis-article">
      <!-- Header: Solid White Card Container to Prevent Background Blending -->
      <header class="article-header">
        <div class="article-period-tag">{item.period}</div>
        <h1 class="article-title">{item.title}</h1>
        <div class="article-author">
          Author: <strong>{item.author}</strong>
        </div>

        <!-- Critical Approach Card -->
        <div class="lens-highlight-card">
          <div class="lens-card-header">
            <span class="lens-label">Critical Lens:</span>
            <span class="lens-name">{item.lens}</span>
          </div>
          <p class="lens-desc">{item.lensDefinition}</p>
        </div>
      </header>

    <!-- Visual Representation Frame (Clean bookish plate) -->
    <div class="visual-representation-box">
      <div class="visual-canvas">
        <img 
          src={item.imagePlaceholder} 
          alt={`${item.title} illustrated plate`} 
          class="analysis-article-plate-img" 
        />
      </div>
      <div class="visual-meta">
        <span class="meta-label">Symbolic Plate:</span>
        <p class="meta-text">{item.visualDescription}</p>
      </div>
    </div>

    <!-- Key Characters Involved in the Masterpiece -->
    <section class="characters-section-card">
      <div class="characters-header">
        <span class="characters-tag">Cast & Dramatis Personae</span>
        <h2 class="characters-title">Key Figures Involved</h2>
      </div>
      <div class="characters-grid">
        {item.characters.map((char) => (
          <div class="character-card">
            <h3 class="char-name">{char.name}</h3>
            <p class="char-role">{char.role}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- The Literary Analysis Body -->
    <div class="analysis-body-sections">
      <section class="analysis-subblock">
        <h3 class="subblock-heading">1. Introduction & Context</h3>
        <p class="subblock-text">{item.fullAnalysis.introduction}</p>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">2. Application of Critical Lens</h3>
        <p class="subblock-text">{item.fullAnalysis.lensApplication}</p>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">3. Textual Evidence & Interpretation</h3>
        <p class="subblock-text">{item.fullAnalysis.textualEvidence}</p>
        
        <div class="key-themes-pill-list">
          <span class="pill-label">Key Themes:</span>
          {item.keyThemes.map((theme) => (
            <span class="theme-tag">{theme}</span>
          ))}
        </div>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">4. Conclusion & Synthesis</h3>
        <p class="subblock-text">{item.fullAnalysis.conclusion}</p>
      </section>
    </div>

    <!-- Navigation between analyses -->
    <nav class="analysis-pagination">
      {prevAnalysis ? (
        <a href={`/analyses/${prevAnalysis.id}`} class="pagination-btn prev-btn">
          <span class="direction">&larr; Previous</span>
          <span class="work-name">{prevAnalysis.title}</span>
        </a>
      ) : (
        <div class="pagination-placeholder"></div>
      )}

      {nextAnalysis ? (
        <a href={`/analyses/${nextAnalysis.id}`} class="pagination-btn next-btn">
          <span class="direction">Next &rarr;</span>
          <span class="work-name">{nextAnalysis.title}</span>
        </a>
      ) : (
        <a href="/favorite" class="pagination-btn next-btn complete-btn">
          <span class="direction">Continue to &rarr;</span>
          <span class="work-name">Favorite Masterpiece</span>
        </a>
      )}
    </nav>
  </article>
  </div>
</Layout>

<style>
  /* Analysis Stage Wrapper: strictly isolates the stage and clips fixed elements above footer */
  .analysis-stage-wrapper {
    position: relative;
    clip-path: inset(0 0 0 0);
    padding-bottom: 4rem;
  }

  /* Full-Bleed Ambient Pixel Landscape Stage (Contained Strictly to Analysis Content) */
  .full-bleed-pixel-stage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-size: cover;
    background-position: center bottom;
    background-repeat: no-repeat;
    opacity: 0.20;
    pointer-events: none;
    z-index: 0;
  }

  .analysis-reader-topbar {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .analysis-article {
    position: relative;
    z-index: 1;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  .article-header,
  .visual-representation-box,
  .characters-section-card,
  .analysis-body-sections,
  .analysis-pagination {
    position: relative;
    z-index: 1;
  }

  /* Article Header: Solid White Card Container to Prevent Background Blending */
  .article-header {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: 8px;
    padding: 2.25rem 2.5rem;
    margin-bottom: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  .article-period-tag {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.25;
    color: var(--color-primary);
  }

  .article-author {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .article-author strong {
    color: var(--color-primary);
  }

  .lens-highlight-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
  }

  .lens-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .lens-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lens-name {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-primary);
  }

  .lens-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Visual Box */
  .visual-representation-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2.75rem;
  }

  .visual-canvas {
    background: var(--color-bg);
    color: var(--color-text);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-border);
    max-height: 380px;
    overflow: hidden;
  }

  .analysis-article-plate-img {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: cover;
    display: block;
  }

  .visual-meta {
    padding: 1rem 1.25rem;
    background: #ffffff;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.88rem;
  }

  .meta-label {
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .meta-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Characters Section */
  .characters-section-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem 2.25rem;
    margin-bottom: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  .characters-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .characters-tag {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.25rem;
  }

  .characters-title {
    font-size: 1.45rem;
    color: var(--color-primary);
    margin: 0;
  }

  .characters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .character-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.25rem 1.35rem;
  }

  .char-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.4rem;
  }

  .char-role {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Body */
  .analysis-body-sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .analysis-subblock {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem;
  }

  .subblock-heading {
    font-size: 1.25rem;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .subblock-text {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }

  .key-themes-pill-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .pill-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .theme-tag {
    font-size: 0.78rem;
    background: var(--color-bg);
    color: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  /* Pagination */
  .analysis-pagination {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .pagination-btn {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
    min-width: 200px;
  }

  .pagination-btn:hover {
    border-color: var(--color-accent);
  }

  .direction {
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .work-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .next-btn {
    text-align: right;
    margin-left: auto;
  }

  @media (max-width: 680px) {
    .article-title {
      font-size: 1.9rem;
    }

    .analysis-subblock {
      padding: 1.5rem;
    }

    .visual-meta {
      flex-direction: column;
      gap: 0.25rem;
    }

    .pagination-btn {
      width: 100%;
      text-align: left;
    }

    .next-btn {
      text-align: left;
    }
  }
</style>
