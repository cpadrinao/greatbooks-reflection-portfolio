---
import Layout from '../../layouts/Layout.astro';
import { analyses, type LiteraryAnalysis } from '../../data/analyses';

export function getStaticPaths() {
  return analyses.map((item) => ({
    params: { id: item.id },
    props: { item }
  }));
}

interface Props {
  item: LiteraryAnalysis;
}

const { item } = Astro.props;

const currentIndex = analyses.findIndex(a => a.id === item.id);
const prevAnalysis = currentIndex > 0 ? analyses[currentIndex - 1] : null;
const nextAnalysis = currentIndex < analyses.length - 1 ? analyses[currentIndex + 1] : null;
---

<Layout 
  title={`${item.title} - Literary Analysis | Great Books`}
  description={`Literary analysis of ${item.title} by ${item.author} using ${item.lens}.`}
>
  <div class="analysis-stage-wrapper">
    <!-- Full-Bleed Ambient Pixel Landscape Stage (Signature Crimson Backing) with Floating Canonical Emojis -->
    <div class="full-bleed-pixel-stage" aria-hidden="true">
      <div class="pixel-stage-backdrop" style={`background-image: url('${item.pixelBg}');`}></div>
      <div class="pixel-stage-vignette"></div>
      
      <!-- Floating Emojis relating to Literary Analysis: 8 icons balanced 4 on each side -->
      <div class="floating-emojis-stage">
        <!-- 4 on Left Side -->
        <span class="floating-emoji float-left-1" title="Classical Canon">📚</span>
        <span class="floating-emoji float-left-2" title="Tragedy & Drama">🎭</span>
        <span class="floating-emoji float-left-3" title="Critical Lens">🔍</span>
        <span class="floating-emoji float-left-4" title="Classical Antiquity">🏛️</span>

        <!-- 4 on Right Side -->
        <span class="floating-emoji float-right-1" title="Ancient Manuscripts">📜</span>
        <span class="floating-emoji float-right-2" title="Epic Conflict">⚔️</span>
        <span class="floating-emoji float-right-3" title="Tragic Kingship">👑</span>
        <span class="floating-emoji float-right-4" title="Close Reading">🕯️</span>
      </div>
    </div>

    <!-- Top Bar -->
    <div class="analysis-reader-topbar">
      <div class="container container-reading topbar-inner">
        <a href="/analyses" class="back-link">
          &larr; Back to Literary Analyses
        </a>
        <span class="tag tag-accent">{item.lens}</span>
      </div>
    </div>

    <article class="container container-reading analysis-article">
      <!-- Header: Solid White Card Container to Prevent Background Blending -->
      <header class="article-header">
        <div class="article-period-tag">{item.period}</div>
        <h1 class="article-title">{item.title}</h1>
        <div class="article-author">
          Author: <strong>{item.author}</strong>
        </div>

        <!-- Critical Approach Card -->
        <div class="lens-highlight-card">
          <div class="lens-card-header">
            <span class="lens-label">Critical Lens:</span>
            <span class="lens-name">{item.lens}</span>
          </div>
          <p class="lens-desc">{item.lensDefinition}</p>
        </div>
      </header>

    <!-- Visual Representation Frame (Clean bookish plate) -->
    <div class="visual-representation-box">
      <div class="visual-canvas">
        <img 
          src={item.imagePlaceholder} 
          alt={`${item.title} illustrated plate`} 
          class="analysis-article-plate-img" 
        />
      </div>
      <div class="visual-meta">
        <span class="meta-label">Symbolic Plate:</span>
        <p class="meta-text">{item.visualDescription}</p>
      </div>
    </div>

    <!-- Key Characters Involved in the Masterpiece -->
    <section class="characters-section-card">
      <div class="characters-header">
        <span class="characters-tag">Cast & Dramatis Personae</span>
        <h2 class="characters-title">Key Figures Involved</h2>
      </div>
      <div class="characters-grid">
        {item.characters.map((char) => (
          <div class="character-card">
            <h3 class="char-name">{char.name}</h3>
            <p class="char-role">{char.role}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- The Literary Analysis Body -->
    <div class="analysis-body-sections">
      <section class="analysis-subblock">
        <h3 class="subblock-heading">1. Introduction & Context</h3>
        <p class="subblock-text">{item.fullAnalysis.introduction}</p>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">2. Application of Critical Lens</h3>
        <p class="subblock-text">{item.fullAnalysis.lensApplication}</p>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">3. Textual Evidence & Interpretation</h3>
        <p class="subblock-text">{item.fullAnalysis.textualEvidence}</p>
        
        <div class="key-themes-pill-list">
          <span class="pill-label">Key Themes:</span>
          {item.keyThemes.map((theme) => (
            <span class="theme-tag">{theme}</span>
          ))}
        </div>
      </section>

      <section class="analysis-subblock">
        <h3 class="subblock-heading">4. Conclusion & Synthesis</h3>
        <p class="subblock-text">{item.fullAnalysis.conclusion}</p>
      </section>
    </div>

    <!-- Navigation between analyses -->
    <nav class="analysis-pagination">
      {prevAnalysis ? (
        <a href={`/analyses/${prevAnalysis.id}`} class="pagination-btn prev-btn">
          <span class="direction">&larr; Previous</span>
          <span class="work-name">{prevAnalysis.title}</span>
        </a>
      ) : (
        <div class="pagination-placeholder"></div>
      )}

      {nextAnalysis ? (
        <a href={`/analyses/${nextAnalysis.id}`} class="pagination-btn next-btn">
          <span class="direction">Next &rarr;</span>
          <span class="work-name">{nextAnalysis.title}</span>
        </a>
      ) : (
        <a href="/favorite" class="pagination-btn next-btn complete-btn">
          <span class="direction">Continue to &rarr;</span>
          <span class="work-name">Favorite Masterpiece</span>
        </a>
      )}
    </nav>
  </article>
  </div>
</Layout>

<style>
  /* Analysis Stage Wrapper: strictly isolates the stage and clips fixed elements above footer */
  .analysis-stage-wrapper {
    position: relative;
    clip-path: inset(0 0 0 0);
    padding-bottom: 4rem;
  }

  /* Full-Bleed Ambient Pixel Landscape Stage (Signature Book Cloth Crimson Backing) */
  .full-bleed-pixel-stage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-accent); /* #881337 - exact signature red color of the website */
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .pixel-stage-backdrop {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center bottom;
    background-repeat: no-repeat;
    opacity: 0.38; /* Pleasantly visible story setting bathed in website's red hue */
  }

  .pixel-stage-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 35%, rgba(76, 5, 25, 0.5) 100%);
  }

  /* Ambient Floating Emojis Layer: subtle background presence (4 left, 4 right) */
  .floating-emojis-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .floating-emoji {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    color: var(--color-bg);
    opacity: 0.22; /* Soft ambient opacity for true background feel */
    filter: grayscale(100%) brightness(0) invert(98%) sepia(12%) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    user-select: none;
    will-change: transform;
  }

  /* 4 on Left Side */
  .float-left-1 { top: 8%; left: 3.5%; animation: floatDrift 6.5s ease-in-out infinite alternate; }
  .float-left-2 { top: 32%; left: 4.5%; font-size: 2.45rem; animation: floatBob 5.8s ease-in-out infinite alternate; animation-delay: -1.2s; }
  .float-left-3 { top: 58%; left: 2.5%; font-size: 2.1rem; animation: floatTilt 7s ease-in-out infinite alternate; animation-delay: -2.5s; }
  .float-left-4 { bottom: 10%; left: 4%; font-size: 2.3rem; animation: floatDrift 6.2s ease-in-out infinite alternate; animation-delay: -1.8s; }

  /* 4 on Right Side */
  .float-right-1 { top: 12%; right: 3.5%; font-size: 2.5rem; animation: floatBob 5.5s ease-in-out infinite alternate; animation-delay: -0.8s; }
  .float-right-2 { top: 36%; right: 5%; font-size: 2.2rem; animation: floatTilt 6.8s ease-in-out infinite alternate; animation-delay: -2s; }
  .float-right-3 { top: 64%; right: 3%; font-size: 2.4rem; animation: floatDrift 6.4s ease-in-out infinite alternate; animation-delay: -3.2s; }
  .float-right-4 { bottom: 12%; right: 4.5%; font-size: 2.15rem; animation: floatBob 7.2s ease-in-out infinite alternate; animation-delay: -1.5s; }

  @keyframes floatBob {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-22px) rotate(4deg); }
    100% { transform: translateY(-8px) rotate(-3deg); }
  }

  @keyframes floatDrift {
    0% { transform: translate(0px, 0px) rotate(0deg); }
    50% { transform: translate(16px, -18px) rotate(-5deg); }
    100% { transform: translate(-10px, -10px) rotate(4deg); }
  }

  @keyframes floatTilt {
    0% { transform: translateY(0px) rotate(-3deg); }
    50% { transform: translateY(-24px) rotate(6deg); }
    100% { transform: translateY(-12px) rotate(-2deg); }
  }

  .analysis-reader-topbar {
    position: relative;
    z-index: 2;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .analysis-article {
    position: relative;
    z-index: 1;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  .article-header,
  .visual-representation-box,
  .characters-section-card,
  .analysis-body-sections,
  .analysis-pagination {
    position: relative;
    z-index: 1;
  }

  /* Article Header: Solid White Card Container to Prevent Background Blending */
  .article-header {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: 8px;
    padding: 2.25rem 2.5rem;
    margin-bottom: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  .article-period-tag {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.25;
    color: var(--color-primary);
  }

  .article-author {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .article-author strong {
    color: var(--color-primary);
  }

  .lens-highlight-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
  }

  .lens-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .lens-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lens-name {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-primary);
  }

  .lens-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Visual Box */
  .visual-representation-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2.75rem;
  }

  .visual-canvas {
    background: var(--color-bg);
    color: var(--color-text);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-border);
    max-height: 380px;
    overflow: hidden;
  }

  .analysis-article-plate-img {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: cover;
    display: block;
  }

  .visual-meta {
    padding: 1rem 1.25rem;
    background: #ffffff;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.88rem;
  }

  .meta-label {
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .meta-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Characters Section */
  .characters-section-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem 2.25rem;
    margin-bottom: 2.75rem;
    box-shadow: var(--shadow-sm);
  }

  .characters-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .characters-tag {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.25rem;
  }

  .characters-title {
    font-size: 1.45rem;
    color: var(--color-primary);
    margin: 0;
  }

  .characters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .character-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.25rem 1.35rem;
  }

  .char-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.4rem;
  }

  .char-role {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Body */
  .analysis-body-sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .analysis-subblock {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem;
  }

  .subblock-heading {
    font-size: 1.25rem;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .subblock-text {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }

  .key-themes-pill-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .pill-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .theme-tag {
    font-size: 0.78rem;
    background: var(--color-bg);
    color: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  /* Pagination */
  .analysis-pagination {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .pagination-btn {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
    min-width: 200px;
  }

  .pagination-btn:hover {
    border-color: var(--color-accent);
  }

  .direction {
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .work-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .next-btn {
    text-align: right;
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .floating-emoji {
      font-size: 1.5rem;
      opacity: 0.16;
    }
    .float-left-1 { top: 6%; left: 1.5%; }
    .float-left-2 { top: 28%; left: 2%; font-size: 1.6rem; }
    .float-left-3 { top: 54%; left: 1.5%; }
    .float-left-4 { bottom: 8%; left: 2%; }

    .float-right-1 { top: 10%; right: 1.5%; font-size: 1.6rem; }
    .float-right-2 { top: 34%; right: 2%; }
    .float-right-3 { top: 60%; right: 1.5%; font-size: 1.6rem; }
    .float-right-4 { bottom: 10%; right: 2%; }
  }

  @media (max-width: 680px) {
    .article-title {
      font-size: 1.9rem;
    }

    .analysis-subblock {
      padding: 1.5rem;
    }

    .visual-meta {
      flex-direction: column;
      gap: 0.25rem;
    }

    .pagination-btn {
      width: 100%;
      text-align: left;
    }

    .next-btn {
      text-align: left;
    }
  }
</style>
