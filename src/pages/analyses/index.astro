---
import Layout from '../../layouts/Layout.astro';
import { analyses } from '../../data/analyses';
---

<Layout 
  title="Literary Analyses | Great Books Portfolio"
  description="Compilation of seven literary analyses examined through different critical lenses."
>
  <div class="analyses-stage-wrapper">
    <!-- Full-Bleed Ambient Stage (Signature Book Cloth Crimson Backing) with Floating Canonical Emojis -->
    <div class="full-bleed-pixel-stage" aria-hidden="true">
      <div class="pixel-stage-vignette"></div>
      
      <!-- Floating Emojis relating to Literary Analysis: 8 icons balanced 4 on each side -->
      <div class="floating-emojis-stage">
        <!-- 4 on Left Side -->
        <span class="floating-emoji float-left-1" title="Classical Canon">📚</span>
        <span class="floating-emoji float-left-2" title="Tragedy & Drama">🎭</span>
        <span class="floating-emoji float-left-3" title="Critical Lens">🔍</span>
        <span class="floating-emoji float-left-4" title="Classical Antiquity">🏛️</span>

        <!-- 4 on Right Side -->
        <span class="floating-emoji float-right-1" title="Ancient Manuscripts">📜</span>
        <span class="floating-emoji float-right-2" title="Epic Conflict">⚔️</span>
        <span class="floating-emoji float-right-3" title="Tragic Kingship">👑</span>
        <span class="floating-emoji float-right-4" title="Close Reading">🕯️</span>
      </div>
    </div>

    <div class="page-header-block">
      <div class="container">
        <span class="section-tag">Critical Studies</span>
        <h1>Literary Analyses</h1>
        <p class="lead-text">
          Seven literary masterpieces examined through distinct critical lenses, spanning ancient epic traditions to modern psychological fiction.
        </p>
      </div>
    </div>

    <div class="container analyses-index-area">
    <!-- The 7 Masterpieces Grid -->
    <div class="analyses-stack">
      {analyses.map((item) => (
        <article id={`analysis-${item.id}`} class="analysis-card">
          <div class="card-aside">
            <div class:list={["visual-placeholder-frame", { "is-vertical-frame": item.imageOrientation === "vertical" }]}>
              <div class="plate-img-wrapper">
                <img 
                  src={item.imagePlaceholder} 
                  alt={`${item.title} illustration: ${item.visualDescription}`} 
                  class:list={["analysis-plate-thumb", { "thumb-vertical": item.imageOrientation === "vertical" }]}
                  loading="lazy" 
                />
              </div>
              <span class="visual-caption">{item.visualDescription}</span>
            </div>
          </div>

          <div class="card-main">
            <div class="card-meta-header">
              <span class="tag tag-accent">{item.lens}</span>
              <span class="period-tag">{item.period}</span>
            </div>

            <h2 class="analysis-work-title">{item.title}</h2>
            <div class="analysis-author">Author: <strong>{item.author}</strong></div>

            <div class="lens-definition-box">
              <strong>Critical Approach:</strong> {item.lensDefinition}
            </div>

            <p class="analysis-summary-quote">{item.excerpt}</p>

            <!-- Key Figures Involved -->
            <div class="characters-preview-row">
              <span class="characters-label">Key Figures:</span>
              <div class="characters-pills-list">
                {item.characters.map((c) => (
                  <span class="character-pill" title={c.role}>{c.name}</span>
                ))}
              </div>
            </div>

            <div class="key-themes-row">
              <span class="themes-label">Themes:</span>
              {item.keyThemes.map((theme) => (
                <span class="theme-chip">{theme}</span>
              ))}
            </div>

            <div class="analysis-card-footer">
              <a href={`/analyses/${item.id}`} class="btn btn-primary">
                Read Full Analysis &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Next Section Navigation -->
    <div class="next-step-bar">
      <span>Continue reading:</span>
      <a href="/favorite" class="btn btn-primary">
        Favorite Masterpiece &rarr;
      </a>
    </div>
  </div>
  </div>
</Layout>

<style>
  /* Analyses Stage Wrapper: strictly isolates the stage and clips fixed elements above footer */
  .analyses-stage-wrapper {
    position: relative;
    clip-path: inset(0 0 0 0);
    padding-bottom: 4rem;
  }

  /* Full-Bleed Ambient Stage (Signature Book Cloth Crimson Backing) */
  .full-bleed-pixel-stage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-accent); /* #881337 - signature crimson red */
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .pixel-stage-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 35%, rgba(76, 5, 25, 0.5) 100%);
  }

  /* Ambient Floating Emojis Layer: subtle background presence (4 left, 4 right) */
  .floating-emojis-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .floating-emoji {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    color: var(--color-bg);
    opacity: 0.22; /* Soft ambient opacity for true background feel */
    filter: grayscale(100%) brightness(0) invert(98%) sepia(12%) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    user-select: none;
    will-change: transform;
  }

  /* 4 on Left Side */
  .float-left-1 { top: 8%; left: 3.5%; animation: floatDrift 6.5s ease-in-out infinite alternate; }
  .float-left-2 { top: 32%; left: 4.5%; font-size: 2.45rem; animation: floatBob 5.8s ease-in-out infinite alternate; animation-delay: -1.2s; }
  .float-left-3 { top: 58%; left: 2.5%; font-size: 2.1rem; animation: floatTilt 7s ease-in-out infinite alternate; animation-delay: -2.5s; }
  .float-left-4 { bottom: 10%; left: 4%; font-size: 2.3rem; animation: floatDrift 6.2s ease-in-out infinite alternate; animation-delay: -1.8s; }

  /* 4 on Right Side */
  .float-right-1 { top: 12%; right: 3.5%; font-size: 2.5rem; animation: floatBob 5.5s ease-in-out infinite alternate; animation-delay: -0.8s; }
  .float-right-2 { top: 36%; right: 5%; font-size: 2.2rem; animation: floatTilt 6.8s ease-in-out infinite alternate; animation-delay: -2s; }
  .float-right-3 { top: 64%; right: 3%; font-size: 2.4rem; animation: floatDrift 6.4s ease-in-out infinite alternate; animation-delay: -3.2s; }
  .float-right-4 { bottom: 12%; right: 4.5%; font-size: 2.15rem; animation: floatBob 7.2s ease-in-out infinite alternate; animation-delay: -1.5s; }

  @keyframes floatBob {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-22px) rotate(4deg); }
    100% { transform: translateY(-8px) rotate(-3deg); }
  }

  @keyframes floatDrift {
    0% { transform: translate(0px, 0px) rotate(0deg); }
    50% { transform: translate(16px, -18px) rotate(-5deg); }
    100% { transform: translate(-10px, -10px) rotate(4deg); }
  }

  @keyframes floatTilt {
    0% { transform: translateY(0px) rotate(-3deg); }
    50% { transform: translateY(-24px) rotate(6deg); }
    100% { transform: translateY(-12px) rotate(-2deg); }
  }

  .page-header-block {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .analyses-index-area {
    position: relative;
    z-index: 1;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }

  /* Analyses Stack */
  .analyses-stack {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin-bottom: 3rem;
  }

  .analysis-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.25rem;
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .card-aside {
    display: flex;
    flex-direction: column;
  }

  .visual-placeholder-frame {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    overflow: hidden;
  }

  .plate-img-wrapper {
    width: 100%;
    height: 220px;
    background: #f3f1ec;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    box-shadow: 0 2px 6px rgba(28, 25, 23, 0.06);
  }

  .analysis-plate-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  /* Dedicated handling for vertical portrait artwork (The Panchatantra) */
  .analysis-plate-thumb.thumb-vertical {
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
  }

  .visual-caption {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .card-main {
    display: flex;
    flex-direction: column;
  }

  .card-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .period-tag {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .analysis-work-title {
    font-size: 1.65rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
    color: var(--color-primary);
  }

  .analysis-author {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .analysis-author strong {
    color: var(--color-primary);
  }

  .lens-definition-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .analysis-summary-quote {
    font-size: 0.96rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 1.25rem;
  }

  .characters-preview-row {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px dashed var(--color-border);
  }

  .characters-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-warm-brown);
    white-space: nowrap;
  }

  .characters-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .character-pill {
    font-size: 0.78rem;
    font-weight: 600;
    background: #ffffff;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.55rem;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(41, 37, 36, 0.04);
  }

  .key-themes-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .themes-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .theme-chip {
    font-size: 0.78rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .analysis-card-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    margin-top: auto;
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
  }

  .next-step-bar span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .analysis-card {
      grid-template-columns: 1fr;
    }

    .visual-placeholder-frame {
      min-height: 110px;
    }
  }

  @media (max-width: 768px) {
    .floating-emoji {
      font-size: 1.5rem;
      opacity: 0.16;
    }
    .float-left-1 { top: 6%; left: 1.5%; }
    .float-left-2 { top: 28%; left: 2%; font-size: 1.6rem; }
    .float-left-3 { top: 54%; left: 1.5%; }
    .float-left-4 { bottom: 8%; left: 2%; }

    .float-right-1 { top: 10%; right: 1.5%; font-size: 1.6rem; }
    .float-right-2 { top: 34%; right: 2%; }
    .float-right-3 { top: 60%; right: 1.5%; font-size: 1.6rem; }
    .float-right-4 { bottom: 10%; right: 2%; }
  }

  @media (max-width: 600px) {
    .next-step-bar {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
