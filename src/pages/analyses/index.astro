---
import Layout from '../../layouts/Layout.astro';
import { analyses } from '../../data/analyses';
---

<Layout 
  title="Literary Analyses | Great Books Portfolio"
  description="Compilation of seven literary analyses examined through different critical lenses."
>
  <div class="page-header-block">
    <div class="container">
      <span class="section-tag">Critical Studies</span>
      <h1>Literary Analyses</h1>
      <p class="lead-text">
        Seven literary masterpieces examined through distinct critical lenses, spanning ancient epic traditions to modern psychological fiction.
      </p>
    </div>
  </div>

  <div class="container analyses-index-area">
    <!-- The 7 Masterpieces Grid -->
    <div class="analyses-stack">
      {analyses.map((item) => (
        <article id={`analysis-${item.id}`} class="analysis-card">
          <div class="card-aside">
            <div class="visual-placeholder-frame">
              <img 
                src={item.imagePlaceholder} 
                alt={`${item.title} symbolic plate`} 
                class="analysis-plate-thumb"
                loading="lazy" 
              />
              <span class="visual-caption">{item.visualDescription}</span>
            </div>
          </div>

          <div class="card-main">
            <div class="card-meta-header">
              <span class="tag tag-accent">{item.lens}</span>
              <span class="period-tag">{item.period}</span>
            </div>

            <h2 class="analysis-work-title">{item.title}</h2>
            <div class="analysis-author">Author: <strong>{item.author}</strong></div>

            <div class="lens-definition-box">
              <strong>Critical Approach:</strong> {item.lensDefinition}
            </div>

            <p class="analysis-summary-quote">{item.excerpt}</p>

            <!-- Key Figures Involved -->
            <div class="characters-preview-row">
              <span class="characters-label">Key Figures:</span>
              <div class="characters-pills-list">
                {item.characters.map((c) => (
                  <span class="character-pill" title={c.role}>{c.name}</span>
                ))}
              </div>
            </div>

            <div class="key-themes-row">
              <span class="themes-label">Themes:</span>
              {item.keyThemes.map((theme) => (
                <span class="theme-chip">{theme}</span>
              ))}
            </div>

            <div class="analysis-card-footer">
              <a href={`/analyses/${item.id}`} class="btn btn-primary">
                Read Full Analysis &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Next Section Navigation -->
    <div class="next-step-bar">
      <span>Continue reading:</span>
      <a href="/favorite" class="btn btn-primary">
        Favorite Masterpiece &rarr;
      </a>
    </div>
  </div>
</Layout>

<style>
  .analyses-index-area {
    padding-bottom: 3.5rem;
  }

  /* Analyses Stack */
  .analyses-stack {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin-bottom: 3rem;
  }

  .analysis-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.25rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .card-aside {
    display: flex;
    flex-direction: column;
  }

  .visual-placeholder-frame {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.85rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    overflow: hidden;
  }

  .analysis-plate-thumb {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    margin-bottom: 0.75rem;
    box-shadow: var(--shadow-sm);
  }

  .visual-caption {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .card-main {
    display: flex;
    flex-direction: column;
  }

  .card-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .period-tag {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .analysis-work-title {
    font-size: 1.65rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
    color: var(--color-primary);
  }

  .analysis-author {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .analysis-author strong {
    color: var(--color-primary);
  }

  .lens-definition-box {
    background: var(--color-bg);
    border-left: 3px solid var(--color-border-dark);
    padding: 0.75rem 1rem;
    border-radius: 0 4px 4px 0;
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .analysis-summary-quote {
    font-size: 0.96rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 1.25rem;
  }

  .characters-preview-row {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px dashed var(--color-border);
  }

  .characters-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-warm-brown);
    white-space: nowrap;
  }

  .characters-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .character-pill {
    font-size: 0.78rem;
    font-weight: 600;
    background: #ffffff;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.55rem;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(41, 37, 36, 0.04);
  }

  .key-themes-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .themes-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .theme-chip {
    font-size: 0.78rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .analysis-card-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    margin-top: auto;
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
  }

  .next-step-bar span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .analysis-card {
      grid-template-columns: 1fr;
    }

    .visual-placeholder-frame {
      min-height: 110px;
    }
  }
</style>
