---
import Layout from '../../layouts/Layout.astro';
import { analyses } from '../../data/analyses';
---

<Layout 
  title="Literary Analyses | Great Books Portfolio"
  description="Compilation of seven literary analyses examined through different critical lenses."
>
  <div class="page-header-block">
    <div class="container">
      <span class="section-tag">Critical Studies</span>
      <h1>Literary Analyses</h1>
      <p class="lead-text">
        Seven literary masterpieces examined through distinct critical lenses, spanning ancient epic traditions to modern psychological fiction.
      </p>
    </div>
  </div>

  <div class="container analyses-index-area">
    <!-- Clean Filter / Jump List -->
    <div class="lenses-navigation">
      <span class="lenses-label">Filter by Masterpiece:</span>
      <div class="lenses-pills-list">
        {analyses.map((item) => (
          <a href={`#analysis-${item.id}`} class="lens-pill-jump">
            <span class="pill-title">{item.title}</span>
            <span class="pill-lens">({item.lens.split('/')[0]})</span>
          </a>
        ))}
      </div>
    </div>

    <!-- The 7 Masterpieces Grid -->
    <div class="analyses-stack">
      {analyses.map((item) => (
        <article id={`analysis-${item.id}`} class="analysis-card">
          <div class="card-aside">
            <div class="visual-placeholder-frame">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="book-icon">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                <path d="M6 6h10"></path>
                <path d="M6 10h10"></path>
              </svg>
              <span class="visual-caption">{item.visualDescription}</span>
            </div>
          </div>

          <div class="card-main">
            <div class="card-meta-header">
              <span class="tag tag-accent">{item.lens}</span>
              <span class="period-tag">{item.period}</span>
            </div>

            <h2 class="analysis-work-title">{item.title}</h2>
            <div class="analysis-author">Author: <strong>{item.author}</strong></div>

            <div class="lens-definition-box">
              <strong>Critical Approach:</strong> {item.lensDefinition}
            </div>

            <p class="analysis-summary-quote">{item.excerpt}</p>

            <div class="key-themes-row">
              <span class="themes-label">Themes:</span>
              {item.keyThemes.map((theme) => (
                <span class="theme-chip">{theme}</span>
              ))}
            </div>

            <div class="analysis-card-footer">
              <a href={`/analyses/${item.id}`} class="btn btn-primary">
                Read Full Analysis &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Next Section Navigation -->
    <div class="next-step-bar">
      <span>Continue reading:</span>
      <a href="/favorite" class="btn btn-primary">
        Favorite Masterpiece &rarr;
      </a>
    </div>
  </div>
</Layout>

<style>
  .analyses-index-area {
    padding-bottom: 3.5rem;
  }

  .lenses-navigation {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .lenses-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .lenses-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lens-pill-jump {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.35rem 0.75rem;
    font-size: 0.82rem;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.15s ease;
  }

  .lens-pill-jump:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: #ffffff;
  }

  .pill-title {
    font-weight: 500;
  }

  .pill-lens {
    font-size: 0.76rem;
    color: var(--color-text-muted);
  }

  /* Analyses Stack */
  .analyses-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .analysis-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.25rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
  }

  .card-aside {
    display: flex;
    flex-direction: column;
  }

  .visual-placeholder-frame {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.5rem 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 160px;
  }

  .book-icon {
    color: var(--color-warm-brown);
    margin-bottom: 0.75rem;
  }

  .visual-caption {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .card-main {
    display: flex;
    flex-direction: column;
  }

  .card-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .period-tag {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .analysis-work-title {
    font-size: 1.65rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
    color: var(--color-primary);
  }

  .analysis-author {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .analysis-author strong {
    color: var(--color-primary);
  }

  .lens-definition-box {
    background: var(--color-bg);
    border-left: 3px solid var(--color-border-dark);
    padding: 0.75rem 1rem;
    border-radius: 0 4px 4px 0;
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .analysis-summary-quote {
    font-size: 0.96rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 1.25rem;
  }

  .key-themes-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .themes-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .theme-chip {
    font-size: 0.78rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .analysis-card-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    margin-top: auto;
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
  }

  .next-step-bar span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .analysis-card {
      grid-template-columns: 1fr;
    }

    .visual-placeholder-frame {
      min-height: 110px;
    }
  }
</style>
