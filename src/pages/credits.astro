---
import Layout from '../layouts/Layout.astro';
import { analyses } from '../data/analyses';

// Video sources catalog combining the 7 analyses plus The Iliad
const videoSources = [
  {
    title: "Voice out of the Whirlwind (Book of Job)",
    creator: "Light of All Mankind Bible",
    youtubeUrl: "https://youtu.be/WBRPB5UfymQ",
    youtubeId: "WBRPB5UfymQ",
    category: "Near Eastern Wisdom Literature",
    summary: "A comprehensive biblical narrative explaining Job's trials, cosmic dialogue, and divine revelation out of the tempest."
  },
  {
    title: "The Panchatantra",
    creator: "Ithihasam - Indian Scriptures",
    youtubeUrl: "https://youtu.be/iwJjrgAqWos",
    youtubeId: "iwJjrgAqWos",
    category: "Classical Indian Niti Fables",
    summary: "Visual storytelling exploring the moral fables, street smarts, and nested frame tales compiled by Pandit Vishnu Sharma."
  },
  {
    title: "The Ramayana",
    creator: "Peekaboo Kidz",
    youtubeUrl: "https://youtu.be/cvCv7kTcRXI",
    youtubeId: "cvCv7kTcRXI",
    category: "Ancient Indian Epic Tradition",
    summary: "An accessible breakdown of Prince Rama's exile, Sita's devotion, Hanuman's loyalty, and the triumph of Dharma over evil."
  },
  {
    title: "The Mahabharata",
    creator: "Overly Sarcastic Productions",
    youtubeUrl: "https://youtu.be/42W6axXrIuw",
    youtubeId: "42W6axXrIuw",
    category: "Ancient Indian Epic Tradition",
    summary: "A witty, insightful animated analysis breaking down the dynastic tensions, moral crises, and Kurukshetra battle."
  },
  {
    title: "The Odyssey",
    creator: "Unknown Frequencies",
    youtubeUrl: "https://youtu.be/mJS-QVw8lzY",
    youtubeId: "mJS-QVw8lzY",
    category: "Classical Greek Epic",
    summary: "Detailed overview covering Odysseus's ten-year journey home, mythical encounters, and psychological trials."
  },
  {
    title: "The Song of Roland",
    creator: "Book Recap",
    youtubeUrl: "https://youtu.be/_fR4_HI84Fo",
    youtubeId: "_fR4_HI84Fo",
    category: "Medieval French Chanson de Geste",
    summary: "Narrative recap of the battle at Roncevaux pass, Roland's chivalric pride, Ganelon's betrayal, and Charlemagne's grief."
  },
  {
    title: "The Tale of Genji",
    creator: "Pivotal Pages",
    youtubeUrl: "https://youtu.be/BAD1gARMVho",
    youtubeId: "BAD1gARMVho",
    category: "Classical Japanese Heian Literature",
    summary: "Literary review highlighting Heian court aesthetics, Prince Genji's romantic quests, and the feminine perspective of Murasaki Shikibu."
  },
  {
    title: "The Iliad",
    creator: "Unknown Frequencies",
    youtubeUrl: "https://youtu.be/X3_q5A18qfc",
    youtubeId: "X3_q5A18qfc",
    category: "Classical Greek Epic",
    summary: "In-depth summary exploring the wrath of Achilles, the tragedy of the Trojan War, and the profound meeting between Achilles and King Priam."
  }
];

// Visual plates catalog combining all 8 illustrations
const visualPlates = [
  {
    work: "Voice out of the Whirlwind",
    path: "/images/literary-pics/voice_whirlwind.jpg",
    caption: "Job kneeling in the dust in humble contemplation while the radiant divine presence and whirlwind sweep across the landscape.",
    subject: "Book of Job illustration"
  },
  {
    work: "The Panchatantra",
    path: "/images/literary-pics/panchantantra.jpg",
    caption: "Illustrated book cover depicting the quick-witted rabbit standing on the well rim outsmarting the lion king.",
    subject: "Classical Indian animal fable art"
  },
  {
    work: "The Ramayana",
    path: "/images/literary-pics/ramayana.jpg",
    caption: "Prince Rama and Sita arriving triumphant in an ornate golden chariot drawn by white horses before the citizens of Ayodhya.",
    subject: "Ancient epic coronation painting"
  },
  {
    work: "The Mahabharata",
    path: "/images/literary-pics/mahabharata.jpg",
    caption: "Lord Krishna steering the war chariot beside Prince Arjuna as armies assemble on the sacred plains of Kurukshetra.",
    subject: "Bhagavad Gita battlefield illustration"
  },
  {
    work: "The Odyssey",
    path: "/images/literary-pics/odyssey.jpg",
    caption: "Greek champion looking out from coastal bluffs over expedition ships and twilight fortresses.",
    subject: "Homeric heroic journey artwork"
  },
  {
    work: "The Song of Roland",
    path: "/images/literary-pics/song_of_roland.jpg",
    caption: "Knight Roland in chainmail sounding the ivory Olifant horn in the Pyrenees mountain pass during the rearguard stand.",
    subject: "Medieval chivalric illumination"
  },
  {
    work: "The Tale of Genji",
    path: "/images/literary-pics/tale_of_genji.jpg",
    caption: "Classical Heian painting of a noblewoman in layered silk robes behind court screens, from The Tale of Genji Illuminated.",
    subject: "Japanese Heian court watercolor"
  },
  {
    work: "The Iliad",
    path: "/images/literary-pics/illiad.jpg",
    caption: "Classical artwork portraying the heroic confrontation, tragic anger of Achilles, and mortal sorrow before the walls of Troy.",
    subject: "Homeric epic warfare painting"
  }
];

// Masterpieces & literary traditions
const literaryTraditions = [
  {
    title: "Voice out of the Whirlwind",
    tradition: "Ancient Hebrew Wisdom Tradition (Book of Job)",
    era: "c. 6th to 4th Century BCE",
    region: "Ancient Near East",
    focus: "Ecocritical balance, suffering, and humility before the untamed cosmos."
  },
  {
    title: "The Panchatantra",
    tradition: "Pandit Vishnu Sharma",
    era: "c. 300 BCE to 300 CE",
    region: "Classical India",
    focus: "Structuralist nested fables, practical political ethics, and social wisdom."
  },
  {
    title: "The Ramayana",
    tradition: "Sage Valmiki",
    era: "c. 5th to 4th Century BCE",
    region: "Ancient India",
    focus: "Archetypal hero quest, righteous duty (Dharma), and unyielding loyalty."
  },
  {
    title: "The Mahabharata",
    tradition: "Sage Vyasa",
    era: "c. 4th Century BCE to 4th Century CE",
    region: "Ancient India",
    focus: "Socioeconomic power dynamics, dynastic warfare, and human cost of elite ambition."
  },
  {
    title: "The Odyssey",
    tradition: "Homer",
    era: "c. 8th Century BCE",
    region: "Ancient Greece",
    focus: "Psychoanalytic exploration of temptation, resilience, and homecoming."
  },
  {
    title: "The Song of Roland",
    tradition: "Anonymous French Chanson de Geste",
    era: "c. 11th Century CE",
    region: "Medieval Europe (France)",
    focus: "Historical feudal vassalage, warrior codes, and the tragic price of pride."
  },
  {
    title: "The Tale of Genji",
    tradition: "Murasaki Shikibu",
    era: "Early 11th Century CE",
    region: "Classical Japan (Heian Period)",
    focus: "Feminist interiority, courtly resilience behind silk screens, and aesthetic sensitivity."
  },
  {
    title: "The Iliad",
    tradition: "Homer",
    era: "c. 8th Century BCE",
    region: "Ancient Greece",
    focus: "Formalist poetic craftsmanship, the wrath of Achilles, and shared human compassion."
  }
];
---

<Layout 
  title="Credits & Sources | Great Books Portfolio"
  description="Attributions and sources for literary texts, historical translations, digital video summaries, visual artwork plates, and background soundtrack."
>
  <div class="credits-stage-wrapper">
    <!-- Full-Bleed Ambient Stage (Signature Book Cloth Crimson Backing) with Floating Canonical Emojis -->
    <div class="full-bleed-pixel-stage" aria-hidden="true">
      <div class="pixel-stage-vignette"></div>
      
      <!-- Floating Emojis relating to Sources, Arts, and Scholarship: 10 icons balanced across margins -->
      <div class="floating-emojis-stage">
        <!-- 5 on Left Side -->
        <span class="floating-emoji float-left-1" title="Music & Soundtrack">🎵</span>
        <span class="floating-emoji float-left-2" title="Visual Artwork">🎨</span>
        <span class="floating-emoji float-left-3" title="Ancient Manuscripts">📜</span>
        <span class="floating-emoji float-left-4" title="Literary Canon">📚</span>
        <span class="floating-emoji float-left-5" title="Civilizational Heritage">🏛️</span>

        <!-- 5 on Right Side -->
        <span class="floating-emoji float-right-1" title="Authorial Craft">✍️</span>
        <span class="floating-emoji float-right-2" title="Digital Video Summaries">🎬</span>
        <span class="floating-emoji float-right-3" title="Analytical Insights">💡</span>
        <span class="floating-emoji float-right-4" title="Critical Inquiry">⚖️</span>
        <span class="floating-emoji float-right-5" title="Academic Scholarship">🎓</span>
      </div>
    </div>

    <!-- Universal Subpage Header Block -->
    <div class="page-header-block">
      <div class="container">
        <span class="section-tag">Attributions & Acknowledgments</span>
        <h1>Credits & Sources</h1>
      </div>
    </div>

    <div class="container container-reading credits-content-area">
      
      <!-- ========================================================
           SECTION 1: Ambient Soundtrack & Musical Score
           ======================================================== -->
      <section class="credits-section">
        <div class="section-banner">
          <h2 class="section-banner-title">Background Ambient Music</h2>
          <p class="section-banner-desc">Continuous musical accompaniment designed to create a calm, contemplative reading environment</p>
        </div>

        <article class="soundtrack-card">
          <div class="soundtrack-media">
            <img 
              src="/images/musiccover.jpg" 
              alt="Killswitch Lullaby Cover Art by Flawed Mangoes" 
              class="soundtrack-cover-img" 
            />
          </div>
          <div class="soundtrack-details">
            <div class="soundtrack-tags-row">
              <span class="tag tag-accent">Featured Audio</span>
              <span class="tag">Instrumental / Ambient</span>
            </div>
            <h3 class="soundtrack-title">Killswitch Lullaby</h3>
            <p class="soundtrack-artist">Composed & Produced by <strong>Flawed Mangoes</strong></p>
            <p class="soundtrack-desc">
              Selected as the portfolio's ambient background score. The reflective guitar progression and mellow atmosphere provide an ideal soundscape for deep literary reading, personal synthesis, and focused exploration across the eight masterpieces.
            </p>
            <div class="soundtrack-meta-pills">
              <span class="meta-pill">Artist: Flawed Mangoes</span>
              <span class="meta-pill">Format: MP3 Audio Stream</span>
              <span class="meta-pill">Widget: Custom Persistent CD Player</span>
            </div>
          </div>
        </article>
      </section>

      <!-- ========================================================
           SECTION 2: Digital Video Summaries & Creators
           ======================================================== -->
      <section class="credits-section">
        <div class="section-banner">
          <h2 class="section-banner-title">Digital Video Summaries</h2>
          <p class="section-banner-desc">Content creators and educational channels providing multimedia overviews of each masterpiece</p>
        </div>

        <div class="cards-stack">
          {videoSources.map((item, index) => (
            <article class="source-card">
              <div class="source-card-header">
                <div class="source-card-title-group">
                  <span class="source-index-num">Source 0{index + 1}</span>
                  <h3 class="source-card-title">{item.title}</h3>
                </div>
                <span class="tag">{item.category}</span>
              </div>

              <p class="source-card-desc">{item.summary}</p>

              <div class="source-card-footer">
                <div class="creator-badge">
                  <span class="creator-label">Creator / Channel:</span>
                  <strong class="creator-name">{item.creator}</strong>
                </div>

                <a 
                  href={item.youtubeUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="video-link-btn"
                  title={`Watch on YouTube: ${item.title}`}
                >
                  <svg class="yt-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                  <span>Watch on YouTube &rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ========================================================
           SECTION 3: Featured Visual Artwork Plates
           ======================================================== -->
      <section class="credits-section">
        <div class="section-banner">
          <h2 class="section-banner-title">Featured Visual Artwork Plates</h2>
          <p class="section-banner-desc">Historical paintings, manuscript illustrations, and classical artistic plates featured on analysis cards</p>
        </div>

        <div class="art-plates-grid">
          {visualPlates.map((plate) => (
            <article class="plate-credit-card">
              <div class="plate-thumb-container">
                <img 
                  src={plate.path} 
                  alt={plate.caption} 
                  class="plate-thumb-img" 
                  loading="lazy" 
                />
              </div>
              <div class="plate-text-body">
                <span class="plate-subject-tag">{plate.subject}</span>
                <h4 class="plate-work-title">{plate.work}</h4>
                <p class="plate-caption-text">{plate.caption}</p>
                <div class="plate-file-path">File: <code>{plate.path}</code></div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ========================================================
           SECTION 4: Studied Literary Works & Traditions
           ======================================================== -->
      <section class="credits-section">
        <div class="section-banner">
          <h2 class="section-banner-title">Studied Literary Works & Traditions</h2>
          <p class="section-banner-desc">Primary texts, historical traditions, and authors forming the foundation of our Great Books curriculum</p>
        </div>

        <div class="traditions-stack">
          {literaryTraditions.map((work) => (
            <article class="tradition-card">
              <div class="tradition-header">
                <div>
                  <h3 class="tradition-title">{work.title}</h3>
                  <span class="tradition-author">Author / Tradition: <strong>{work.tradition}</strong></span>
                </div>
                <span class="tradition-region-pill">{work.region}</span>
              </div>
              <div class="tradition-meta-row">
                <span class="tradition-era">Historical Period: {work.era}</span>
              </div>
              <p class="tradition-focus">{work.focus}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ========================================================
           SECTION 5: Academic & Production Colophon
           ======================================================== -->
      <section class="credits-section">
        <div class="section-banner">
          <h2 class="section-banner-title">Colophon & Technology Stack</h2>
          <p class="section-banner-desc">Course information, institutional guidance, and digital web development specifications</p>
        </div>

        <div class="colophon-card">
          <div class="colophon-grid">
            <div class="colophon-item">
              <span class="colophon-label">Course Title</span>
              <strong class="colophon-val">Great Books NRs</strong>
            </div>

            <div class="colophon-item">
              <span class="colophon-label">Student Researcher</span>
              <strong class="colophon-val">Crisler Annilov B. Padrinao</strong>
            </div>

            <div class="colophon-item">
              <span class="colophon-label">Design & Typography</span>
              <strong class="colophon-val">Poppins (Indian Type Foundry / Google Fonts)</strong>
            </div>

            <div class="colophon-item">
              <span class="colophon-label">Web Technology</span>
              <strong class="colophon-val">Astro Static Site Generation & HTML5 / CSS3</strong>
            </div>

            <div class="colophon-item colophon-item-wide">
              <span class="colophon-label">Palette & Aesthetic</span>
              <strong class="colophon-val">Warm Linen (#fbfaf7), Book Press Ink (#110e0c), Cloth Crimson (#881337)</strong>
            </div>
          </div>

          <div class="academic-integrity-note">
            <h4 class="integrity-title">Academic & Fair Use Notice</h4>
            <p class="integrity-body">
              This digital portfolio was created strictly for academic inquiry, personal reflection, and educational evaluation within the Great Books course. All excerpts, references to translations, artistic plates, video summaries, and musical soundtrack pieces remain the property of their respective creators and copyright holders, and are utilized here under fair use principles for non-commercial educational purposes.
            </p>
          </div>
        </div>
      </section>

      <!-- Bottom Navigation Bar -->
      <nav class="credits-bottom-nav">
        <a href="/reflection" class="btn btn-secondary">
          &larr; Reflection & Summary
        </a>
        <a href="/" class="btn btn-primary">
          Portfolio Home &rarr;
        </a>
      </nav>

    </div>
  </div>
</Layout>

<style>
  /* Stage Wrapper */
  .credits-stage-wrapper {
    position: relative;
    clip-path: inset(0 0 0 0);
    padding-bottom: 4rem;
  }

  /* Full-Bleed Ambient Stage (Signature Book Cloth Crimson Backing) */
  .full-bleed-pixel-stage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-accent); /* #881337 signature crimson */
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .pixel-stage-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 35%, rgba(76, 5, 25, 0.5) 100%);
  }

  /* Floating Emojis */
  .floating-emojis-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .floating-emoji {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    color: var(--color-bg);
    opacity: 0.22;
    filter: grayscale(100%) brightness(0) invert(98%) sepia(12%) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    user-select: none;
    will-change: transform;
  }

  /* 5 on Left Side */
  .float-left-1 { top: 7%; left: 3.5%; animation: floatDrift 6.5s ease-in-out infinite alternate; }
  .float-left-2 { top: 27%; left: 4.5%; font-size: 2.45rem; animation: floatBob 5.8s ease-in-out infinite alternate; animation-delay: -1.2s; }
  .float-left-3 { top: 49%; left: 2.5%; font-size: 2.1rem; animation: floatTilt 7s ease-in-out infinite alternate; animation-delay: -2.5s; }
  .float-left-4 { top: 71%; left: 4.5%; font-size: 2.35rem; animation: floatDrift 6.2s ease-in-out infinite alternate; animation-delay: -1.8s; }
  .float-left-5 { bottom: 8%; left: 3%; font-size: 2.2rem; animation: floatBob 6.8s ease-in-out infinite alternate; animation-delay: -3s; }

  /* 5 on Right Side */
  .float-right-1 { top: 9%; right: 3.5%; font-size: 2.5rem; animation: floatBob 5.5s ease-in-out infinite alternate; animation-delay: -0.8s; }
  .float-right-2 { top: 28%; right: 5%; font-size: 2.2rem; animation: floatTilt 6.8s ease-in-out infinite alternate; animation-delay: -2s; }
  .float-right-3 { top: 48%; right: 3%; font-size: 2.4rem; animation: floatDrift 6.4s ease-in-out infinite alternate; animation-delay: -3.2s; }
  .float-right-4 { top: 68%; right: 4.5%; font-size: 2.15rem; animation: floatBob 7.2s ease-in-out infinite alternate; animation-delay: -1.5s; }
  .float-right-5 { bottom: 9%; right: 3%; font-size: 2.3rem; animation: floatTilt 6s ease-in-out infinite alternate; animation-delay: -2.8s; }

  @keyframes floatBob {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-22px) rotate(4deg); }
    100% { transform: translateY(-8px) rotate(-3deg); }
  }

  @keyframes floatDrift {
    0% { transform: translate(0px, 0px) rotate(0deg); }
    50% { transform: translate(16px, -18px) rotate(-5deg); }
    100% { transform: translate(-10px, -10px) rotate(4deg); }
  }

  @keyframes floatTilt {
    0% { transform: translateY(0px) rotate(-3deg); }
    50% { transform: translateY(-24px) rotate(6deg); }
    100% { transform: translateY(-12px) rotate(-2deg); }
  }

  .page-header-block {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .credits-content-area {
    position: relative;
    z-index: 1;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .credits-section {
    margin-bottom: 3rem;
  }

  /* Section Header Banners */
  .section-banner {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .section-banner-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.35rem;
    line-height: 1.25;
  }

  .section-banner-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }

  /* Soundtrack Card */
  .soundtrack-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .soundtrack-media {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .soundtrack-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .soundtrack-details {
    flex-grow: 1;
  }

  .soundtrack-tags-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .soundtrack-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.25rem;
  }

  .soundtrack-artist {
    font-size: 0.95rem;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .soundtrack-artist strong {
    color: var(--color-accent);
  }

  .soundtrack-desc {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .soundtrack-meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-pill {
    font-size: 0.78rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    color: var(--color-text-muted);
  }

  /* Video Summaries Cards Stack */
  .cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .source-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .source-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .source-card-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .source-index-num {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
