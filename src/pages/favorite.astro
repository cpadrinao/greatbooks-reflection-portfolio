---
import Layout from '../layouts/Layout.astro';

const favorite = {
  title: "The Iliad",
  author: "Homer",
  period: "Ancient Greece (c. 8th Century BCE)",
  lens: "Formalist / New Critical Lens",
  lensDefinition: "Examining Homer's poetic craftsmanship—ring composition, recurring epithets, the symbolism of Achilles’ celestial shield, and the tragic irony of mortal glory.",
  primaryTheme: "The Wrath of Achilles, the Tragedy of War, and Shared Human Compassion",
  quote: "Sing, Goddess, the wrath of Achilles, Peleus' son, the destructive wrath that brought countless sorrows upon the Achaeans...",
  plateImage: "/images/analyses/iliad.svg",
  pixelBg: "/images/pixel-bg/pixel-iliad.svg",
  overview: "Set during the tenth and final year of the Trojan War, The Iliad does not try to tell the entire decade-long war from beginning to end. Instead, Homer focuses intensely on a few tragic weeks centered around the anger, withdrawal, and devastating grief of Greece's greatest warrior, Achilles. When King Agamemnon publicly dishonors him, Achilles angrily pulls his troops from battle, leaving the Greek army on the brink of disaster. The war only turns when Achilles' closest friend, Patroclus, takes Achilles' armor to rescue his comrades and is killed by the Trojan prince Hector. Shattered by guilt and rage, Achilles returns to the battlefield, kills Hector, and desecrates his body—until an unforgettable night meeting with Hector's grieving father, King Priam, finally restores his humanity.",
  reasonsForChoice: [
    {
      title: "Lorem Ipsum Rationale Alpha",
      desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris."
    },
    {
      title: "Lorem Ipsum Rationale Beta",
      desc: "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia."
    },
    {
      title: "Lorem Ipsum Rationale Gamma",
      desc: "Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt."
    }
  ],
  themesAndCharacters: {
    characters: [
      { 
        name: "Achilles", 
        role: "The fiercest warrior of Greece, torn between fragile pride, uncontrollable grief, and a haunting awareness that glorious war only leads to an early grave." 
      },
      { 
        name: "Hector", 
        role: "Crown prince and chief defender of Troy, fighting not out of bloodlust or personal ambition, but out of devotion to protect his family, city, and people." 
      },
      { 
        name: "Patroclus", 
        role: "Achilles' beloved companion whose tender empathy for the suffering Greek soldiers leads him to lead the troops into battle, triggering the epic's climax." 
      },
      { 
        name: "King Priam", 
        role: "The aged monarch of Troy who displays extraordinary courage by slipping into the enemy camp alone to kneel before Achilles and beg for the return of Hector's body." 
      }
    ],
    lessons: "Homer strips away any artificial glamour from battlefield combat. The Iliad shows that war brings universal heartbreak to both sides of the trench, and that genuine greatness lies not in ruthless slaughter, but in recognizing our shared mortality and showing compassion to our enemies."
  },
  personalConnections: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
};
---

<Layout 
  title="Favorite Literary Masterpiece | The Iliad"
  description="In-depth spotlight on my favorite literary masterpiece: Homer's The Iliad."
>
  <div class="favorite-stage-wrapper">
    <!-- Full-Bleed Ambient Pixel Landscape Stage (Strictly Contained Above Footer) -->
    <div class="full-bleed-pixel-stage" style={`background-image: url('${favorite.pixelBg}');`} aria-hidden="true"></div>

    <div class="page-header-block">
    <div class="container">
      <span class="section-tag">Featured Selection</span>
      <h1>Favorite Literary Masterpiece</h1>
      <p class="lead-text">
        An in-depth study of the most memorable work discussed throughout our Great Books curriculum: Homer's epic of anger, mortality, and compassion.
      </p>
    </div>
  </div>

  <div class="container container-reading favorite-content-area">
    <!-- Spotlight Card (Classic Bookish Presentation) -->
    <div class="spotlight-card">
      <div class="spotlight-top">
        <span class="tag tag-accent">{favorite.lens}</span>
        <span class="period-text">{favorite.period}</span>
      </div>
      <h2 class="spotlight-title">{favorite.title}</h2>
      <div class="spotlight-author">By <strong>{favorite.author}</strong></div>
      
      <!-- Symbolic Illustrated Plate -->
      <div class="favorite-plate-frame">
        <img 
          src={favorite.plateImage} 
          alt="The Iliad symbolic plate showing Achilles' celestial shield and Trojan walls" 
          class="favorite-plate-img" 
        />
        <span class="plate-caption">The divine celestial shield of Achilles and the fortified walls of Troy</span>
      </div>

      <div class="spotlight-quote-box">
        <blockquote>&ldquo;{favorite.quote}&rdquo;</blockquote>
        <span class="quote-citation">Homer, <em>The Iliad</em>, Book I, lines 1–2</span>
      </div>
    </div>

    <!-- Section 1: Overview -->
    <section class="editorial-section">
      <h3 class="section-title">Overview of the Epic</h3>
      <div class="section-text">
        <p>{favorite.overview}</p>
      </div>
    </section>

    <!-- Section 2: Reasons for Selection -->
    <section class="editorial-section">
      <h3 class="section-title">Why This Masterpiece Resonated</h3>
      <div class="reasons-grid">
        {favorite.reasonsForChoice.map((reason) => (
          <div class="reason-card">
            <h4 class="reason-title">{reason.title}</h4>
            <p class="reason-desc">{reason.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Significant Themes & Characters -->
    <section class="editorial-section">
      <h3 class="section-title">Key Figures & Tragic Roles</h3>
      
      <div class="characters-list">
        {favorite.themesAndCharacters.characters.map((char) => (
          <div class="character-item">
            <div class="char-name">{char.name}</div>
            <div class="char-role">{char.role}</div>
          </div>
        ))}
      </div>

      <div class="lesson-card">
        <h4 class="lesson-title">Core Theme:</h4>
        <p class="lesson-text">{favorite.themesAndCharacters.lessons}</p>
      </div>
    </section>

    <!-- Section 4: Personal Connections -->
    <section class="editorial-section">
      <h3 class="section-title">Personal Realizations & Reflections</h3>
      <div class="section-text">
        <p>{favorite.personalConnections}</p>
      </div>
    </section>

    <!-- Next Section Navigation -->
    <div class="next-step-bar">
      <span>Continue reading:</span>
      <a href="/reflection" class="btn btn-primary">
        Learning Summary & Reflection &rarr;
      </a>
    </div>
  </div>
  </div>
</Layout>

<style>
  /* Favorite Stage Wrapper: strictly isolates the stage and clips fixed elements above footer */
  .favorite-stage-wrapper {
    position: relative;
    clip-path: inset(0 0 0 0);
    padding-bottom: 4rem;
  }

  /* Full-Bleed Ambient Pixel Landscape Stage (Contained Strictly to Favorite Content) */
  .full-bleed-pixel-stage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-size: cover;
    background-position: center bottom;
    background-repeat: no-repeat;
    opacity: 0.20;
    pointer-events: none;
    z-index: 0;
  }

  .page-header-block {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .favorite-content-area {
    position: relative;
    z-index: 1;
    padding-bottom: 2rem;
  }

  .spotlight-card,
  .editorial-section,
  .next-step-bar {
    position: relative;
    z-index: 1;
  }

  .spotlight-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: 8px;
    padding: 2.5rem 2.25rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .spotlight-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .period-text {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .spotlight-title {
    font-size: 2.25rem;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .spotlight-author {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .spotlight-author strong {
    color: var(--color-primary);
  }

  /* Plate Frame */
  .favorite-plate-frame {
    margin-bottom: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg);
  }

  .favorite-plate-img {
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    display: block;
  }

  .plate-caption {
    display: block;
    padding: 0.65rem 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
    background: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .spotlight-quote-box {
    background: var(--color-bg);
    border-left: 3px solid var(--color-accent);
    padding: 1.25rem 1.5rem;
    border-radius: 0 4px 4px 0;
  }

  .spotlight-quote-box blockquote {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
    line-height: 1.6;
  }

  .quote-citation {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Editorial Sections */
  .editorial-section {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.25rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .section-title {
    font-size: 1.35rem;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin: 0 0 1.25rem;
  }

  .section-text {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--color-text);
  }

  .section-text p {
    margin: 0;
  }

  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .reason-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.25rem;
  }

  .reason-title {
    font-size: 0.98rem;
    color: var(--color-accent);
    margin: 0 0 0.4rem;
  }

  .reason-desc {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .characters-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .character-item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }

  .char-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
    font-family: var(--font-heading);
  }

  .char-role {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .lesson-card {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: 6px;
    padding: 1.25rem;
  }

  .lesson-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .lesson-text {
    font-size: 0.95rem;
    color: #4c0519;
    line-height: 1.7;
    margin: 0;
    font-style: italic;
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
  }

  .next-step-bar span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }
</style>
