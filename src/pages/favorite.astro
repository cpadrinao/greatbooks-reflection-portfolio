---
import Layout from '../layouts/Layout.astro';

const favorite = {
  title: "The Iliad",
  author: "Homer",
  period: "Ancient Greece (c. 8th Century BCE)",
  lens: "Formalist / New Critical Lens",
  lensDefinition: "Examining Homer's poetic craftsmanship, including ring composition, recurring epithets, the symbolism of Achilles’ celestial shield, and the tragic irony of mortal glory.",
  primaryTheme: "The Wrath of Achilles, the Tragedy of War, and Shared Human Compassion",
  quote: "Sing, Goddess, the wrath of Achilles, Peleus' son, the destructive wrath that brought countless sorrows upon the Achaeans...",
  plateImage: "/images/literary-pics/illiad.jpg",
  pixelBg: "/images/pixel-bg/pixel-iliad.svg",
  overview: "Set during the tenth and final year of the Trojan War, The Iliad does not try to tell the entire decade-long war from beginning to end. Instead, Homer focuses intensely on a few tragic weeks centered around the anger, withdrawal, and devastating grief of Greece's greatest warrior, Achilles. When King Agamemnon publicly dishonors him, Achilles angrily pulls his troops from battle, leaving the Greek army on the brink of disaster. The war only turns when Achilles' closest friend, Patroclus, takes Achilles' armor to rescue his comrades and is killed by the Trojan prince Hector. Shattered by guilt and rage, Achilles returns to the battlefield, kills Hector, and desecrates his body, until an unforgettable night meeting with Hector's grieving father, King Priam, finally restores his humanity.",
  reasonsForChoice: [
    {
      title: "Honest Portrayal of Conflict",
      desc: "Homer strips away artificial glamour from warfare, showing the genuine grief, terror, and loss felt by families and fighters on both sides of the trench."
    },
    {
      title: "Deeply Relatable Human Flaws",
      desc: "Achilles and Hector are not flawless statues. Their struggles with pride, vulnerability, fear, and sorrow make them feel intensely human."
    },
    {
      title: "The Healing Power of Compassion",
      desc: "The emotional peak where Achilles and King Priam mourn together proves that recognizing shared pain can break through cycles of hatred and anger."
    }
  ],
  themesAndCharacters: {
    characters: [
      { 
        name: "Achilles", 
        role: "The fiercest warrior of Greece, torn between fragile pride, uncontrollable grief, and a haunting awareness that glorious war only leads to an early grave." 
      },
      { 
        name: "Hector", 
        role: "Crown prince and chief defender of Troy, fighting not out of bloodlust or personal ambition, but out of devotion to protect his family, city, and people." 
      },
      { 
        name: "Patroclus", 
        role: "Achilles' beloved companion whose tender empathy for the suffering Greek soldiers leads him to lead the troops into battle, triggering the epic's climax." 
      },
      { 
        name: "King Priam", 
        role: "The aged monarch of Troy who displays extraordinary courage by slipping into the enemy camp alone to kneel before Achilles and beg for the return of Hector's body." 
      }
    ],
    lessons: "Homer strips away any artificial glamour from battlefield combat. The Iliad shows that war brings universal heartbreak to both sides of the trench, and that genuine greatness lies not in ruthless slaughter, but in recognizing our shared mortality and showing compassion to our enemies."
  },
  personalConnections: "This book reveals how unchecked pride, anger, and ego can bring down talented groups. When leaders fixate on personal rivalries, the entire community ends up paying the price. In my own academic and project experiences, I have seen how quickly misunderstandings or stubborn pride can derail an otherwise capable team. Reading The Iliad taught me that putting personal ego aside, listening with empathy, and working toward shared goals are what truly hold communities together."
};
---

<Layout 
  title="Favorite Literary Masterpiece | The Iliad"
  description="In-depth spotlight on my favorite literary masterpiece: Homer's The Iliad."
>
  <div class="favorite-stage-wrapper">
    <!-- Full-Bleed Ambient Pixel Landscape Stage (Signature Book Cloth Crimson Backing) with Floating Epic Emojis -->
    <div class="full-bleed-pixel-stage" aria-hidden="true">
      <div class="pixel-stage-backdrop" style={`background-image: url('${favorite.pixelBg}');`}></div>
      <div class="pixel-stage-vignette"></div>
      
      <!-- Floating Emojis relating to The Iliad: 8 icons balanced 4 on each side -->
      <div class="floating-emojis-stage">
        <!-- 4 on Left Side -->
        <span class="floating-emoji float-left-1" title="Achilles' Shield">🛡️</span>
        <span class="floating-emoji float-left-2" title="Epic Combat">⚔️</span>
        <span class="floating-emoji float-left-3" title="Trojan Citadel">🏛️</span>
        <span class="floating-emoji float-left-4" title="Homeric Verse">📜</span>

        <!-- 4 on Right Side -->
        <span class="floating-emoji float-right-1" title="Monarchs & Honor">👑</span>
        <span class="floating-emoji float-right-2" title="Heroic Archery">🏹</span>
        <span class="floating-emoji float-right-3" title="Ancient Antiquity">🏺</span>
        <span class="floating-emoji float-right-4" title="Shared Compassion">🕊️</span>
      </div>
    </div>

    <div class="page-header-block">
    <div class="container">
      <span class="section-tag">Featured Selection</span>
      <h1>Favorite Literary Masterpiece</h1>
      <p class="lead-text">
        An in-depth study of the most memorable work discussed throughout our Great Books curriculum: Homer's epic of anger, mortality, and compassion.
      </p>
    </div>
  </div>

  <div class="container container-reading favorite-content-area">
    <!-- Spotlight Card (Classic Bookish Presentation) -->
    <div class="spotlight-card">
      <div class="spotlight-top">
        <span class="tag tag-accent">{favorite.lens}</span>
        <span class="period-text">{favorite.period}</span>
      </div>
      <h2 class="spotlight-title">{favorite.title}</h2>
      <div class="spotlight-author">By <strong>{favorite.author}</strong></div>
      
      <!-- Illustrated Artwork Frame -->
      <div class="favorite-plate-frame">
        <img 
          src={favorite.plateImage} 
          alt="The Iliad battle scene showing Greek warriors clashing before the walls of Troy with warships on the sea and Olympian gods watching from the clouds" 
          class="favorite-plate-img" 
        />
        <span class="plate-caption">Greek warriors clashing in sword combat before ancient warships, the stone walls of Troy, and the watching Olympian gods.</span>
      </div>

      <div class="spotlight-quote-box">
        <blockquote>&ldquo;{favorite.quote}&rdquo;</blockquote>
        <span class="quote-citation">Homer, <em>The Iliad</em>, Book I, lines 1 to 2</span>
      </div>
    </div>

    <!-- Section 1: Overview -->
    <section class="editorial-section">
      <h3 class="section-title">Overview of the Epic</h3>
      <div class="section-text">
        <p>{favorite.overview}</p>
      </div>
    </section>

    <!-- Section 2: Reasons for Selection -->
    <section class="editorial-section">
      <h3 class="section-title">Why This Masterpiece Resonated</h3>
      <div class="reasons-grid">
        {favorite.reasonsForChoice.map((reason) => (
          <div class="reason-card">
            <h4 class="reason-title">{reason.title}</h4>
            <p class="reason-desc">{reason.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Significant Themes & Characters -->
    <section class="editorial-section">
      <h3 class="section-title">Key Figures & Tragic Roles</h3>
      
      <div class="characters-list">
        {favorite.themesAndCharacters.characters.map((char) => (
          <div class="character-item">
            <div class="char-name">{char.name}</div>
            <div class="char-role">{char.role}</div>
          </div>
        ))}
      </div>

      <div class="lesson-card">
        <h4 class="lesson-title">Core Theme:</h4>
        <p class="lesson-text">{favorite.themesAndCharacters.lessons}</p>
      </div>
    </section>

    <!-- Section 4: Personal Connections -->
    <section class="editorial-section">
      <h3 class="section-title">Personal Realizations & Reflections</h3>
      <div class="section-text">
        <p>{favorite.personalConnections}</p>
      </div>
    </section>

    <!-- Next Section Navigation -->
    <div class="next-step-bar">
      <span>Continue reading:</span>
      <a href="/reflection" class="btn btn-primary">
        Learning Summary & Reflection &rarr;
      </a>
    </div>
  </div>
  </div>
</Layout>

<style>
  /* Favorite Stage Wrapper: strictly isolates the stage and clips fixed elements above footer */
  .favorite-stage-wrapper {
    position: relative;
    clip-path: inset(0 0 0 0);
    padding-bottom: 4rem;
  }

  /* Full-Bleed Ambient Pixel Landscape Stage (Signature Book Cloth Crimson Backing) */
  .full-bleed-pixel-stage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-accent); /* #881337 - exact signature red color of the website */
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .pixel-stage-backdrop {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center bottom;
    background-repeat: no-repeat;
    opacity: 0.38;
  }

  .pixel-stage-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 35%, rgba(76, 5, 25, 0.5) 100%);
  }

  /* Ambient Floating Emojis Layer: subtle background presence (4 left, 4 right) */
  .floating-emojis-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .floating-emoji {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    color: var(--color-bg);
    opacity: 0.22; /* Soft ambient opacity for true background feel */
    filter: grayscale(100%) brightness(0) invert(98%) sepia(12%) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    user-select: none;
    will-change: transform;
  }

  /* 4 on Left Side */
  .float-left-1 { top: 8%; left: 3.5%; animation: floatDrift 6.5s ease-in-out infinite alternate; }
  .float-left-2 { top: 32%; left: 4.5%; font-size: 2.45rem; animation: floatBob 5.8s ease-in-out infinite alternate; animation-delay: -1.2s; }
  .float-left-3 { top: 58%; left: 2.5%; font-size: 2.1rem; animation: floatTilt 7s ease-in-out infinite alternate; animation-delay: -2.5s; }
  .float-left-4 { bottom: 10%; left: 4%; font-size: 2.3rem; animation: floatDrift 6.2s ease-in-out infinite alternate; animation-delay: -1.8s; }

  /* 4 on Right Side */
  .float-right-1 { top: 12%; right: 3.5%; font-size: 2.5rem; animation: floatBob 5.5s ease-in-out infinite alternate; animation-delay: -0.8s; }
  .float-right-2 { top: 36%; right: 5%; font-size: 2.2rem; animation: floatTilt 6.8s ease-in-out infinite alternate; animation-delay: -2s; }
  .float-right-3 { top: 64%; right: 3%; font-size: 2.4rem; animation: floatDrift 6.4s ease-in-out infinite alternate; animation-delay: -3.2s; }
  .float-right-4 { bottom: 12%; right: 4.5%; font-size: 2.15rem; animation: floatBob 7.2s ease-in-out infinite alternate; animation-delay: -1.5s; }

  @keyframes floatBob {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-22px) rotate(4deg); }
    100% { transform: translateY(-8px) rotate(-3deg); }
  }

  @keyframes floatDrift {
    0% { transform: translate(0px, 0px) rotate(0deg); }
    50% { transform: translate(16px, -18px) rotate(-5deg); }
    100% { transform: translate(-10px, -10px) rotate(4deg); }
  }

  @keyframes floatTilt {
    0% { transform: translateY(0px) rotate(-3deg); }
    50% { transform: translateY(-24px) rotate(6deg); }
    100% { transform: translateY(-12px) rotate(-2deg); }
  }

  .page-header-block {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .favorite-content-area {
    position: relative;
    z-index: 1;
    padding-bottom: 2rem;
  }

  .spotlight-card,
  .editorial-section,
  .next-step-bar {
    position: relative;
    z-index: 1;
  }

  .spotlight-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: 8px;
    padding: 2.5rem 2.25rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .spotlight-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .period-text {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .spotlight-title {
    font-size: 2.25rem;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .spotlight-author {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .spotlight-author strong {
    color: var(--color-primary);
  }

  /* Plate Frame */
  .favorite-plate-frame {
    margin-bottom: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg);
  }

  .favorite-plate-img {
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    display: block;
  }

  .plate-caption {
    display: block;
    padding: 0.65rem 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
    background: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .spotlight-quote-box {
    background: var(--color-bg);
    border-left: 3px solid var(--color-accent);
    padding: 1.25rem 1.5rem;
    border-radius: 0 4px 4px 0;
  }

  .spotlight-quote-box blockquote {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
    line-height: 1.6;
  }

  .quote-citation {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Editorial Sections */
  .editorial-section {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.25rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .section-title {
    font-size: 1.35rem;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin: 0 0 1.25rem;
  }

  .section-text {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--color-text);
  }

  .section-text p {
    margin: 0;
  }

  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .reason-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.25rem;
  }

  .reason-title {
    font-size: 0.98rem;
    color: var(--color-accent);
    margin: 0 0 0.4rem;
  }

  .reason-desc {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .characters-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .character-item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }

  .char-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
    font-family: var(--font-heading);
  }

  .char-role {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .lesson-card {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: 6px;
    padding: 1.25rem;
  }

  .lesson-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .lesson-text {
    font-size: 0.95rem;
    color: #4c0519;
    line-height: 1.7;
    margin: 0;
    font-style: italic;
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
  }

  .next-step-bar span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }

  @media (max-width: 768px) {
    .floating-emoji {
      font-size: 1.5rem;
      opacity: 0.16;
    }
    .float-left-1 { top: 6%; left: 1.5%; }
    .float-left-2 { top: 28%; left: 2%; font-size: 1.6rem; }
    .float-left-3 { top: 54%; left: 1.5%; }
    .float-left-4 { bottom: 8%; left: 2%; }

    .float-right-1 { top: 10%; right: 1.5%; font-size: 1.6rem; }
    .float-right-2 { top: 34%; right: 2%; }
    .float-right-3 { top: 60%; right: 1.5%; font-size: 1.6rem; }
    .float-right-4 { bottom: 10%; right: 2%; }
  }

  @media (max-width: 600px) {
    .next-step-bar {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
