---
import Layout from '../layouts/Layout.astro';
import { analyses } from '../data/analyses';

const sections = [
  {
    title: "Student Profile",
    route: "/profile",
    description: "An introduction presenting personal background, reading interests, and academic journey in the Great Books course.",
    category: "Literary Analyzer",
    chapter: "Chapter I"
  },
  {
    title: "Literary Analyses",
    route: "/analyses",
    description: "A collection of seven literary masterpieces examined through different critical lenses from antiquity to the modern era.",
    category: "Core Analyses",
    chapter: "Chapter II"
  },
  {
    title: "Favorite Masterpiece",
    route: "/favorite",
    description: "An in-depth exploration of the most memorable work studied, exploring its core themes, memorable figures, and personal resonance.",
    category: "Featured Work",
    chapter: "Chapter III"
  },
  {
    title: "Learning Summary & Reflection",
    route: "/reflection",
    description: "A unified synthesis combining core academic takeaways, critical lenses, and personal reading reflections across our Great Books journey.",
    category: "Reflections & Values",
    chapter: "Chapter IV"
  }
];

// 3 repetitions = 12 cards per sequence (4,320px wide), ensuring seamless looping with zero empty space on all screens up to 4K
const carouselSequence = [...sections, ...sections, ...sections];

const coverThemes = [
  { bg: "#182635", border: "#d97706", accentColor: "#fbbf24", textLight: "#f1f5f9" },
  { bg: "#7a1128", border: "#d97706", accentColor: "#fde68a", textLight: "#fff1f2" },
  { bg: "#163824", border: "#d97706", accentColor: "#fde68a", textLight: "#f0fdf4" },
  { bg: "#451a03", border: "#d97706", accentColor: "#fde68a", textLight: "#fef3c7" },
  { bg: "#3b1747", border: "#d97706", accentColor: "#f5d0fe", textLight: "#faf5ff" },
  { bg: "#1f2937", border: "#d97706", accentColor: "#fde68a", textLight: "#f9fafb" },
  { bg: "#581c1c", border: "#d97706", accentColor: "#fed7aa", textLight: "#fff7ed" }
];
---

<Layout 
  title="My Literary Journey | Great Books Portfolio"
  description="A personal digital portfolio showcasing literary analyses, critical lenses, and reading reflections."
>
  <!-- Hero Section: Clean Ivory White (#ffffff) with Ambient Floating Book Silhouettes -->
  <section class="hero-section">
    <!-- Ambient Animated Floating Book Layer -->
    <div class="floating-books-stage" aria-hidden="true">
      <div class="floating-element float-book-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="68" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          <line x1="12" y1="7" x2="12" y2="21"></line>
        </svg>
      </div>

      <div class="floating-element float-book-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
          <path d="M6 6h10"></path>
          <path d="M6 10h10"></path>
        </svg>
      </div>

      <div class="floating-element float-book-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
      </div>

      <div class="floating-element float-page-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="8" y1="13" x2="16" y2="13"></line>
        </svg>
      </div>

      <div class="floating-element float-ribbon">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
        </svg>
      </div>

      <div class="floating-chip chip-1">
        <span>&bull; Antiquity to Modernity</span>
      </div>
      <div class="floating-chip chip-2">
        <span>&bull; Critical Lenses</span>
      </div>
    </div>

    <!-- Hero Content -->
    <div class="container hero-container">
      <div class="hero-text-col">
        <div class="hero-label">
          <span class="ornament-leaf">&#10086;</span>
          <span>Great Books Digital Portfolio</span>
          <span class="ornament-leaf">&#10087;</span>
        </div>
        
        <h1 class="hero-heading">
          My Literary Journey
        </h1>
        
        <p class="hero-lead">
          An exploration of timeless literary masterpieces across civilizational eras. 
          Discover critical analyses, thematic reflections, and the enduring human dilemmas 
          studied throughout our Great Books course.
        </p>

        <div class="hero-cta-row">
          <a href="/analyses" class="btn btn-primary">
            <span>Explore Literary Analyses</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/profile" class="btn btn-outline">
            About the Reader
          </a>
        </div>
      </div>

      <!-- Solid, Clean 3D Hardcover Book (Floating Bob + Perspective Hover Tilt) -->
      <div class="hero-book-showcase">
        <div class="book-3d-wrapper">
          <div class="book-3d">
            <!-- Spine with Raised Hubbed Bands -->
            <div class="book-spine">
              <span class="spine-line"></span>
              <span class="spine-line"></span>
              <span class="spine-line"></span>
              <span class="spine-line"></span>
            </div>

            <!-- Front Hardcover Face with Corner Brackets -->
            <div class="cover-face">
              <span class="corner-bracket corner-tl"></span>
              <span class="corner-bracket corner-tr"></span>
              <span class="corner-bracket corner-bl"></span>
              <span class="corner-bracket corner-br"></span>

              <div class="cover-filigree">
                <div class="cover-inner-frame">
                  <span class="cover-monogram">&#10086;</span>
                  <span class="cover-series">CLASSICAL CANON</span>
                  <h2 class="cover-title">GREAT<br/>BOOKS</h2>
                  <div class="cover-divider"></div>
                  <span class="cover-subtitle">A Digital Portfolio</span>
                  <span class="cover-edition">LITERARY ARCHIVE</span>
                </div>
              </div>

              <!-- Silk Ribbon Bookmark -->
              <div class="ribbon-bookmark">
                <div class="ribbon-tail"></div>
              </div>
            </div>

            <!-- Stacked Page Thickness Edges -->
            <div class="book-pages-right"></div>
            <div class="book-pages-bottom"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Exploration Chapters (Clean Soothing Blush #fbf5f5 with Bookbinder & Bookmark Details) -->
  <section class="sections-overview">
    <div class="container header-container">
      <div class="overview-header">
        <span class="overview-tag">Portfolio Chapters</span>
        <h2>Exploration Chapters</h2>
        <p class="overview-subtitle">
          Bound volumes documenting critical analysis, ethical inquiry, and personal literary growth.
        </p>
      </div>
    </div>

    <!-- Smooth Left-to-Right Moving Glider Rail (Pauses on Hover) -->
    <div class="glider-carousel-viewport">
      <div class="glider-track">
        <!-- Sequence 1 (12 cards) -->
        {carouselSequence.map((sec) => (
          <a href={sec.route} class="hub-card book-binder-card">
            <!-- Draped Silk Bookmark Ribbon -->
            <div class="card-bookmark-ribbon">
              <div class="bookmark-tail"></div>
            </div>

            <!-- Brass Corner Protectors -->
            <span class="card-corner card-corner-tr"></span>
            <span class="card-corner card-corner-br"></span>

            <!-- Bookbinder Spine with Stitched Edge -->
            <div class="card-binder-spine">
              <span class="spine-stitch"></span>
              <span class="spine-stitch"></span>
              <span class="spine-stitch"></span>
            </div>

            <div class="card-inner-body">
              <div class="card-meta">
                <span class="card-chapter-label">{sec.chapter}</span>
                <span class="card-category">&bull; {sec.category}</span>
              </div>

              <h3 class="card-title">{sec.title}</h3>
              <p class="card-description">{sec.description}</p>
              
              <div class="card-footer">
                <span class="explore-text">Open Volume &rarr;</span>
              </div>
            </div>
          </a>
        ))}

        <!-- Duplicated Sequence 2 for Continuous Seamless Loop (12 cards) -->
        {carouselSequence.map((sec) => (
          <a href={sec.route} class="hub-card book-binder-card" aria-hidden="true">
            <div class="card-bookmark-ribbon">
              <div class="bookmark-tail"></div>
            </div>

            <span class="card-corner card-corner-tr"></span>
            <span class="card-corner card-corner-br"></span>

            <div class="card-binder-spine">
              <span class="spine-stitch"></span>
              <span class="spine-stitch"></span>
              <span class="spine-stitch"></span>
            </div>

            <div class="card-inner-body">
              <div class="card-meta">
                <span class="card-chapter-label">{sec.chapter}</span>
                <span class="card-category">&bull; {sec.category}</span>
              </div>

              <h3 class="card-title">{sec.title}</h3>
              <p class="card-description">{sec.description}</p>
              
              <div class="card-footer">
                <span class="explore-text">Open Volume &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Selected Masterpieces (Clean White Background with 7 Randomly Rotating Books) -->
  <section class="analyses-strip">
    <div class="container">
      <div class="strip-header">
        <div>
          <span class="overview-tag">Curated Archive</span>
          <h2>Selected Masterpieces</h2>
          <p class="strip-subtitle">
            Rotates randomly on each page visit to fairly showcase all seven literary masterpieces.
          </p>
        </div>
        <a href="/analyses" class="view-link">View all 7 analyses &rarr;</a>
      </div>

      <!-- Book-Shaped Masterpiece Cards Grid (All 7 rendered, 3 displayed randomly on load) -->
      <div class="bookshelf-grid" id="bookshelf-grid">
        {analyses.map((item, index) => {
          const theme = coverThemes[index % coverThemes.length];
          return (
            <div 
              class="book-physical-wrapper" 
              data-masterpiece-card={item.id}
              style={index >= 3 ? "display: none;" : ""}
            >
              <div 
                class="book-physical" 
                style={`--cover-bg: ${theme.bg}; --cover-border: ${theme.border}; --cover-accent: ${theme.accentColor}; --cover-text: ${theme.textLight};`}
              >
                <!-- Bookbinder Metal Corner Caps -->
                <span class="binder-corner corner-top-right"></span>
                <span class="binder-corner corner-bottom-right"></span>

                <!-- Left Spine with Gold Raised Hubbed Bands -->
                <div class="book-physical-spine">
                  <span class="spine-rib rib-1"></span>
                  <span class="spine-rib rib-2"></span>
                  <span class="spine-rib rib-3"></span>
                  <span class="spine-rib rib-4"></span>
                </div>

                <!-- Bookbinder Hinge Line -->
                <div class="cover-hinge-groove"></div>

                <!-- Book Cover Face -->
                <div class="book-physical-cover">
                  <div class="book-inner-border">
                    <div class="book-lens-badge">{item.lens}</div>
                    <h3 class="book-work-title">{item.title}</h3>
                    <div class="book-author-line">By {item.author}</div>
                    <div class="book-fleuron">&#10086;</div>
                    <p class="book-excerpt-text">{item.excerpt}</p>
                    <div class="book-period-footer">{item.period}</div>
                    
                    <a href={`/analyses/${item.id}`} class="book-read-btn">
                      Read Analysis &rarr;
                    </a>
                  </div>
                </div>

                <!-- Stacked Paper Pages Edge -->
                <div class="book-physical-pages"></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Dynamic Random Rotation: Shuffles and displays 3 random masterpieces from the 7 on every page load/restart
  document.addEventListener("DOMContentLoaded", () => {
    const cardWrappers = Array.from(document.querySelectorAll<HTMLElement>("[data-masterpiece-card]"));
    if (cardWrappers.length >= 3) {
      cardWrappers.forEach((el) => {
        el.style.display = "none";
      });

      const indices = Array.from({ length: cardWrappers.length }, (_, i) => i);
      for (let i = indices.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [indices[i], indices[j]] = [indices[j], indices[i]];
      }

      indices.slice(0, 3).forEach((idx) => {
        cardWrappers[idx].style.display = "flex";
      });
    }
  });
</script>

<style>
  /* ----------------------------------------------------
     Hero Section: Clean Ivory White (#ffffff)
     ---------------------------------------------------- */
  .hero-section {
    position: relative;
    padding: 5rem 0 4.5rem;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .floating-books-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .floating-element {
    position: absolute;
    color: var(--color-warm-brown);
    opacity: 0.18;
    filter: drop-shadow(0 2px 4px rgba(41, 37, 36, 0.05));
  }

  .float-book-1 { top: 10%; left: 4%; animation: floatDrift 14s ease-in-out infinite alternate; }
  .float-book-2 { bottom: 12%; left: 44%; animation: floatBob 11s ease-in-out infinite alternate; }
  .float-book-3 { top: 14%; right: 48%; animation: floatTilt 16s ease-in-out infinite alternate; }
  .float-page-1 { top: 60%; left: 6%; animation: floatDrift 13s ease-in-out infinite alternate-reverse; }
  .float-ribbon { bottom: 20%; right: 6%; color: var(--color-accent); opacity: 0.22; animation: floatBob 10s ease-in-out infinite alternate; }

  .floating-chip {
    position: absolute;
    font-size: 0.8rem;
    font-family: var(--font-body);
    font-style: italic;
    color: var(--color-text-muted);
    background: rgba(251, 250, 247, 0.95);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
  }

  .chip-1 { top: 8%; right: 18%; animation: floatBob 9s ease-in-out infinite alternate; }
  .chip-2 { bottom: 8%; left: 18%; animation: floatDrift 12s ease-in-out infinite alternate; }

  @keyframes floatBob {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(2deg); }
    100% { transform: translateY(-4px) rotate(-1deg); }
  }

  @keyframes floatDrift {
    0% { transform: translate(0px, 0px) rotate(0deg); }
    50% { transform: translate(12px, -18px) rotate(-3deg); }
    100% { transform: translate(-8px, -8px) rotate(2deg); }
  }

  @keyframes floatTilt {
    0% { transform: translateY(0px) rotate(-2deg); }
    50% { transform: translateY(-20px) rotate(4deg); }
    100% { transform: translateY(-10px) rotate(-1deg); }
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
  }

  .ornament-leaf { color: var(--color-warm-brown); font-size: 0.95rem; }

  .hero-heading {
    font-family: var(--font-heading);
    font-size: 3.35rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-primary);
    margin: 0 0 1.25rem;
    letter-spacing: -0.01em;
  }

  .hero-lead {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary { background: var(--color-primary); color: #ffffff; }
  .btn-primary:hover { background: var(--color-accent); transform: translateY(-1px); }
  .btn-outline { background: #ffffff; color: var(--color-primary); border: 1px solid var(--color-border-dark); }
  .btn-outline:hover { background: var(--color-bg-alt); }

  /* ----------------------------------------------------
     Solid 3D Hardcover Book Showcase (Floating + Hover Tilt)
     ---------------------------------------------------- */
  .hero-book-showcase {
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1400px;
    padding: 1rem 0;
  }

  .book-3d-wrapper {
    position: relative;
    cursor: pointer;
    animation: gentleBookBob 7s ease-in-out infinite alternate;
  }

  @keyframes gentleBookBob {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-12px); }
  }

  .book-3d {
    position: relative;
    width: 240px;
    height: 330px;
    background: #881337;
    border-radius: 3px 8px 8px 3px;
    box-shadow: 
      -4px 4px 10px rgba(0, 0, 0, 0.15),
      12px 18px 30px rgba(28, 25, 23, 0.18);
    transform: rotateY(-16deg) rotateX(7deg);
    transform-style: preserve-3d;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
  }

  .book-3d-wrapper:hover .book-3d {
    transform: rotateY(-6deg) rotateX(2deg) translateY(-4px) scale(1.02);
    box-shadow: 
      -6px 6px 14px rgba(0, 0, 0, 0.18),
      18px 26px 40px rgba(28, 25, 23, 0.22);
  }

  /* Spine */
  .book-spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 22px;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.35) 0%, rgba(255, 255, 255, 0.1) 40%, rgba(0, 0, 0, 0.2) 100%);
    border-right: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 3px 0 0 3px;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    padding: 1.5rem 0;
  }

  .spine-line {
    height: 3px;
    background: #d97706;
    margin: 0 2px;
    border-radius: 1px;
  }

  .cover-face {
    position: absolute;
    inset: 0;
    padding: 1.25rem 1.25rem 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 3px 8px 8px 3px;
    background: #881337;
  }

  .corner-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid #d97706;
    pointer-events: none;
    z-index: 4;
  }

  .corner-tl { top: 8px; left: 14px; border-right: none; border-bottom: none; }
  .corner-tr { top: 8px; right: 8px; border-left: none; border-bottom: none; }
  .corner-bl { bottom: 8px; left: 14px; border-right: none; border-top: none; }
  .corner-br { bottom: 8px; right: 8px; border-left: none; border-top: none; }

  .cover-filigree {
    height: 100%;
    border: 1px solid #d97706;
    border-radius: 4px;
    padding: 1rem 0.85rem;
    box-shadow: inset 0 0 0 2px rgba(217, 119, 6, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cover-inner-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .cover-monogram { font-size: 1.2rem; color: #fbbf24; }
  .cover-series { font-family: var(--font-body); font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.18em; color: #fde68a; }
  .cover-title {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.05;
    color: #ffffff;
    margin: 0.35rem 0;
    letter-spacing: 0.08em;
  }
  .cover-divider { width: 38px; height: 1px; background: #d97706; margin: 0.25rem 0; }
  .cover-subtitle { font-size: 0.82rem; color: #fde68a; font-style: italic; font-family: var(--font-serif); }
  .cover-edition { font-family: var(--font-body); font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(255, 255, 255, 0.75); margin-top: 0.65rem; }

  .ribbon-bookmark {
    position: absolute;
    top: -4px;
    right: 28px;
    width: 14px;
    height: 110px;
    background: #dc2626;
    box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.25);
    z-index: 5;
  }
  .ribbon-tail {
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 8px;
    background: inherit;
    clip-path: polygon(0% 0%, 100% 0%, 50% 100%);
  }

  .book-pages-right {
    position: absolute;
    top: 3px;
    bottom: 3px;
    right: -10px;
    width: 10px;
    background: repeating-linear-gradient(to right, #fefae0 0px, #fefae0 1px, #e9edc9 1px, #e9edc9 2px);
    border: 1px solid #d5cebf;
    border-left: none;
    border-radius: 0 2px 2px 0;
  }

  .book-pages-bottom {
    position: absolute;
    bottom: -8px;
    left: 20px;
    right: 2px;
    height: 8px;
    background: repeating-linear-gradient(to bottom, #fefae0 0px, #fefae0 1px, #e9edc9 1px, #e9edc9 2px);
    border: 1px solid #d5cebf;
    border-top: none;
    border-radius: 0 0 2px 2px;
  }

  /* ----------------------------------------------------
     Section 1: Exploration Chapters (Clean Soft Blush #fbf5f5)
     Card-Embedded Bookbinder & Draped Ribbon Design
