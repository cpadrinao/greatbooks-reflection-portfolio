---
import Layout from '../layouts/Layout.astro';

const student = {
  name: "Lorem Ipsum Dolor",
  degree: "Bachelor of Science in Information Technology",
  yearSection: "3rd Year - Section A",
  subject: "Great Books (LITR 101)",
  instructor: "Prof. Lorem Ipsum",
  photoPlaceholder: "/images/profile-placeholder.svg",
  bio: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus lacinia odio vitae vestibulum vestibulum. Cras venenatis euismod malesuada. Nulla facilisi. Praesent vulputate quam a nibh scelerisque, nec tincidunt dolor elementum. Donec id turpis et nibh vulputate fringilla sit amet a mi.",
  readingInterests: [
    "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
    "Integer nec odio praesent libero sed cursus ante dapibus",
    "Sed nisi nulla quis sem at nibh elementum imperdiet",
    "Duis sagittis ipsum praesent mauris fusce nec tellus sed"
  ],
  readingExperiences: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident.",
  expectationsAndJourney: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur."
};
---

<Layout 
  title="Student Profile | My Literary Journey"
  description="Personal profile of the student and literary analyzer."
>
  <div class="page-header-block">
    <div class="container">
      <span class="section-tag">Literary Analyzer</span>
      <h1>Student Profile</h1>
      <p class="lead-text">
        An introduction presenting personal background, reading interests, and academic expectations.
      </p>
    </div>
  </div>

  <!-- Split Screen Layout: Left Photo Stays Pinned, Right Content Scrolls -->
  <div class="container profile-split-container">
    <div class="profile-split-grid">
      <!-- Left Column: Sticky Large Photo & Identity Card -->
      <aside class="profile-sticky-column">
        <div class="sticky-profile-card">
          <!-- Bookbinder Brass Corners -->
          <span class="card-corner corner-tl"></span>
          <span class="card-corner corner-tr"></span>
          <span class="card-corner corner-bl"></span>
          <span class="card-corner corner-br"></span>

          <!-- Large Portrait Photo Frame -->
          <div class="large-photo-frame">
            <div class="photo-placeholder-canvas">
              <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="portrait-icon">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span class="photo-label">Portrait Photograph</span>
              <span class="photo-sub">320 &times; 400px Canvas</span>
            </div>
            
            <!-- Bookmark Ribbon Accent on the Photo -->
            <div class="photo-bookmark-tab">
              <div class="tab-tail"></div>
            </div>
          </div>

          <!-- Student Identity Information -->
          <div class="student-identity-block">
            <h2 class="student-name">{student.name}</h2>
            <div class="student-badge-pill">Literary Analyzer</div>

            <div class="identity-rows">
              <div class="id-row">
                <span class="id-label">Program:</span>
                <span class="id-val">{student.degree}</span>
              </div>
              <div class="id-row">
                <span class="id-label">Year & Section:</span>
                <span class="id-val">{student.yearSection}</span>
              </div>
              <div class="id-row">
                <span class="id-label">Course Subject:</span>
                <span class="id-val">{student.subject}</span>
              </div>
              <div class="id-row">
                <span class="id-label">Faculty Mentor:</span>
                <span class="id-val">{student.instructor}</span>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Right Column: Scrollable Narrative Content -->
      <main class="profile-scroll-column">
        <!-- Section 1: Personal Introduction -->
        <section class="profile-narrative-card">
          <div class="card-title-header">
            <h2 class="narrative-heading">Personal Introduction</h2>
          </div>
          <div class="prose-text">
            <p>{student.bio}</p>
            <p>
              Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.
            </p>
          </div>
        </section>

        <!-- Section 2: Reading Interests & Formative Experiences -->
        <section class="profile-narrative-card">
          <div class="card-title-header">
            <h2 class="narrative-heading">Reading Interests & Experiences</h2>
          </div>
          <div class="prose-text">
            <p>{student.readingExperiences}</p>
            
            <h3 class="narrative-subheading">Areas of Literary Curiosity:</h3>
            <ul class="literary-interests-list">
              {student.readingInterests.map((interest) => (
                <li>
                  <span class="bullet-ornament">&#10086;</span>
                  <span>{interest}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Section 3: Course Expectations & Learning Journey -->
        <section class="profile-narrative-card">
          <div class="card-title-header">
            <h2 class="narrative-heading">Course Expectations & Journey</h2>
          </div>
          <div class="prose-text">
            <blockquote class="experience-quote">
              &ldquo;{student.expectationsAndJourney}&rdquo;
            </blockquote>
          </div>
        </section>

        <!-- Navigation Bar to Next Section -->
        <div class="next-step-bar">
          <span class="next-hint">Continue reading the portfolio:</span>
          <a href="/analyses" class="btn btn-primary">
            <span>Literary Analyses</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </main>
    </div>
  </div>
</Layout>

<style>
  .profile-split-container {
    padding-bottom: 5rem;
  }

  .profile-split-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* ----------------------------------------------------
     Left Column: Sticky Large Photo Card
     Pins in place as the user scrolls through the content
     ---------------------------------------------------- */
  .profile-sticky-column {
    position: sticky;
    top: 96px; /* Stays fixed below header during scroll */
    z-index: 10;
  }

  .sticky-profile-card {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  /* Brass Bookbinder Corners */
  .card-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--color-gold);
    pointer-events: none;
    z-index: 4;
    opacity: 0.8;
  }
  .corner-tl { top: 6px; left: 6px; border-right: none; border-bottom: none; }
  .corner-tr { top: 6px; right: 6px; border-left: none; border-bottom: none; }
  .corner-bl { bottom: 6px; left: 6px; border-right: none; border-top: none; }
  .corner-br { bottom: 6px; right: 6px; border-left: none; border-top: none; }

  /* Large Portrait Photo Frame */
  .large-photo-frame {
    position: relative;
    width: 100%;
    height: 380px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
  }

  .photo-placeholder-canvas {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    background: repeating-linear-gradient(
      45deg,
      #fbfaf7,
      #fbfaf7 12px,
      #f5f3ec 12px,
      #f5f3ec 24px
    );
  }

  .portrait-icon {
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }

  .photo-label {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .photo-sub {
    font-size: 0.76rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.25rem;
  }

  .photo-bookmark-tab {
    position: absolute;
    top: 0;
    right: 20px;
    width: 16px;
    height: 48px;
    background: var(--color-accent);
    box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.2);
    z-index: 5;
  }

  .tab-tail {
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 8px;
    background: inherit;
    clip-path: polygon(0% 0%, 100% 0%, 50% 100%);
  }

  /* Student Identity Details */
  .student-identity-block {
    text-align: center;
  }

  .student-name {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.35rem;
    line-height: 1.25;
  }

  .student-badge-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: #fff1f2;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
    border: 1px solid #fecdd3;
  }

  .identity-rows {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-align: left;
    border-top: 1px solid var(--color-border);
    padding-top: 1.15rem;
  }

  .id-row {
    display: flex;
    flex-direction: column;
    font-size: 0.88rem;
  }

  .id-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .id-val {
    color: var(--color-primary);
    font-weight: 600;
    margin-top: 0.1rem;
  }

  /* ----------------------------------------------------
     Right Column: Scrollable Narrative Cards
     ---------------------------------------------------- */
  .profile-scroll-column {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .profile-narrative-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 2.25rem 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .card-title-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .narrative-heading {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }

  .narrative-subheading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 1.75rem 0 0.85rem;
  }

  .prose-text {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--color-text);
  }

  .prose-text p {
    margin: 0 0 1.25rem;
  }

  .prose-text p:last-child {
    margin-bottom: 0;
  }

  .literary-interests-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .literary-interests-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1rem;
  }

  .bullet-ornament {
    color: var(--color-warm-brown);
    font-size: 0.95rem;
  }

  .experience-quote {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.75;
    color: var(--color-primary);
    border-left: 3px solid var(--color-accent);
    padding-left: 1.5rem;
    margin: 0;
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.5rem 2rem;
  }

  .next-hint {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }

  /* ----------------------------------------------------
     Responsive Breakpoint: Unpin gracefully on small screens
     ---------------------------------------------------- */
  @media (max-width: 940px) {
    .profile-split-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .profile-sticky-column {
      position: static; /* Un-sticks gracefully */
    }

    .large-photo-frame {
      height: 320px;
    }
  }
</style>
