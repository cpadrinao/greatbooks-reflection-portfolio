---
import Layout from '../layouts/Layout.astro';

const reflections = [
  {
    topic: "Evolution of Literary Understanding",
    prompt: "How has your understanding and appreciation of literature changed throughout the course?",
    answer: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
  },
  {
    topic: "Navigating Reading Challenges",
    prompt: "What challenges did you encounter when reading and analyzing literary masterpieces, and how did you overcome them?",
    answer: "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo. Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt."
  },
  {
    topic: "Most Influential Critical Approach",
    prompt: "Which literary lens or approach influenced your interpretation of literature the most? Why?",
    answer: "At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate non provident, similique sunt in culpa qui officia deserunt mollitia animi, id est laborum et dolorum fuga. Et harum quidem rerum facilis est et expedita distinctio."
  },
  {
    topic: "Realizations on Society & Human Nature",
    prompt: "What important realizations about life, society, culture, or human nature have you gained?",
    answer: "Nam libero tempore, cum soluta nobis est eligendi optio cumque nihil impedit quo minus id quod maxime placeat facere possimus, omnis voluptas assumenda est, omnis dolor repellendus. Temporibus autem quibusdam et aut officiis debitis aut rerum necessitatibus saepe eveniet ut et voluptates repudiandae sint et molestiae non recusandae."
  },
  {
    topic: "Application to Personal & Professional Life",
    prompt: "How can you apply the lessons and values learned from Great Books in your personal, academic, or future professional life?",
    answer: "Itaque earum rerum hic tenetur a sapiente delectus, ut aut reiciendis voluptatibus maiores alias consequatur aut perferendis doloribus asperiores repellat. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
  }
];
---

<Layout 
  title="Personal Reflection | Great Books Portfolio"
  description="Personal reflections on the reading journey, challenges overcome, and lasting insights gained in Great Books."
>
  <div class="page-header-block">
    <div class="container">
      <span class="section-tag">Reflections & Values</span>
      <h1>Personal Reflection</h1>
      <p class="lead-text">
        A candid synthesis of my intellectual evolution, reading challenges, critical paradigms, and ethical takeaways.
      </p>
    </div>
  </div>

  <div class="container container-reading reflection-content-area">
    <!-- Intro Quote Card -->
    <div class="reflection-quote-card">
      <blockquote class="lead-quote">
        &ldquo;Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.&rdquo;
      </blockquote>
      <span class="quote-caption">Reading & Philosophical Reflection</span>
    </div>

    <!-- 5 Reflection Entries: Clean, natural editorial layout -->
    <div class="questions-stack">
      {reflections.map((item) => (
        <article class="reflection-entry">
          <div class="entry-header">
            <h2 class="entry-topic">{item.topic}</h2>
            <p class="entry-prompt">{item.prompt}</p>
          </div>

          <div class="entry-response">
            <p class="response-body">{item.answer}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Return to Home Navigation -->
    <div class="next-step-bar">
      <span>Back to overview:</span>
      <a href="/" class="btn btn-primary">
        &larr; Portfolio Home
      </a>
    </div>
  </div>
</Layout>

<style>
  .reflection-content-area {
    padding-bottom: 3.5rem;
  }

  .reflection-quote-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    padding: 2rem 2.25rem;
    margin-bottom: 2.5rem;
  }

  .lead-quote {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.75;
    color: var(--color-primary);
    margin: 0 0 0.85rem;
  }

  .quote-caption {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-accent);
  }

  .questions-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .reflection-entry {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .entry-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 2rem;
  }

  .entry-topic {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin: 0 0 0.35rem;
  }

  .entry-prompt {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .entry-response {
    padding: 1.75rem 2rem;
  }

  .response-body {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
  }

  .next-step-bar span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }

  @media (max-width: 680px) {
    .entry-header, .entry-response {
      padding: 1.25rem;
    }

    .reflection-quote-card {
      padding: 1.5rem;
    }
  }
</style>
