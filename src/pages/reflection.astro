---
import Layout from '../layouts/Layout.astro';

// Part I: Core Academic Takeaways (in accessible student tone, avoiding academic jargon)
const learningPillars = [
  {
    title: "Understanding World Classics Across Cultures",
    subtitle: "How ancient stories travel through history and across civilizations",
    description: "Studying works from ancient Mesopotamia, India, Greece, France, and Japan showed that while societies and languages change over time, fundamental human questions remain remarkably similar. Every culture uses storytelling to explore justice, fate, leadership, family obligations, and our place in the world.",
    keyTakeaways: [
      "Literature gives us a direct window into what ancient communities valued, feared, celebrated, and believed.",
      "Comparing epics from different continents reveals shared human themes, such as heroism, loyalty, grief, and mortality.",
      "Reading diverse traditions helps us look beyond our modern assumptions and understand perspectives outside our own."
    ],
    synthesis: "Great stories do not belong to one single era or continent; they express universal truths that speak to readers across generations."
  },
  {
    title: "Applying Diverse Ways of Reading (Critical Lenses)",
    subtitle: "Looking at a single story through different interpretive viewpoints",
    description: "Instead of only summarizing plot events, critical lenses gave us specific frameworks to examine texts on deeper levels. By shifting our perspective, we learned to spot hidden power balances, character motives, natural environments, and symbolic patterns that aren't immediately obvious on first reading.",
    keyTakeaways: [
      "Formalist reading teaches us to appreciate the deliberate craft of language, repeating motifs, and poetic structure.",
      "Marxist and Feminist lenses encourage us to question social class, resource distribution, and gender expectations.",
      "Ecocritical and Psychological lenses connect ancient stories to ecological environments and universal subconscious drives."
    ],
    synthesis: "No single lens tells the entire story. Combining multiple critical approaches gives us a richer, more balanced understanding of any literary work."
  },
  {
    title: "Literature as a Reflection of Human Nature",
    subtitle: "Timeless moral dilemmas, vulnerability, and personal growth",
    description: "Classic literature endures because it captures real human struggles that we still experience today. Whether it is Achilles wrestling with pride and grief, Arjuna facing agonizing family duty, or Genji seeking emotional intimacy, these works remind us that human vulnerability and conflict are universal across centuries.",
    keyTakeaways: [
      "Characters in classic literature make complex moral mistakes rather than fitting into neat categories of pure good or evil.",
      "Engaging deeply with stories builds empathy by allowing us to experience the world through someone else's circumstances and pain.",
      "The lessons from ancient dilemmas help us evaluate our own personal relationships, ethics, and daily decisions."
    ],
    synthesis: "The characters in ancient texts feel alive today because their emotional dilemmas, fears, and hopes mirror our own."
  },
  {
    title: "Cultivating Analytical & Critical Thinking Skills",
    subtitle: "Moving from passive reading to active, evidence-based interpretation",
    description: "The Great Books curriculum trained us to read attentively, search for textual evidence, and construct reasoned interpretations rather than settling for surface impressions. We learned how to question assumptions, identify metaphors, and express personal observations with clarity and conviction.",
    keyTakeaways: [
      "Close reading trains us to notice subtle word choices, recurring patterns, and thematic contrasts within a text.",
      "Backing up arguments with specific textual evidence makes our interpretations credible, clear, and well-supported.",
      "These critical reading habits extend naturally beyond literature into academic research and thoughtful decision-making."
    ],
    synthesis: "Critical reading transforms reading from a passive hobby into an active intellectual inquiry that sharpens how we think and communicate."
  }
];

// Part II: Personal Reflections (Student reflections detailing personal growth and real-world synthesis)
const reflectionQuestions = [
  {
    topic: "Evolution of Literary Understanding",
    prompt: "How has your understanding and appreciation of literature changed throughout the course?",
    answer: "Before taking this course, I mostly read books just to follow the plot or pass exams. I rarely asked why an author chose a certain setting or what message was hidden beneath the story. Studying the Great Books completely changed my perspective. I learned to look past the surface and pay attention to symbolism, cultural context, and recurring themes. Reading ancient stories made me realize that even though thousands of years have passed, people back then dealt with the exact same feelings of love, loss, fear, and ambition that we experience today. Literature is no longer just words on paper to me; it is a conversation across time that helps me understand myself and others better."
  },
  {
    topic: "Navigating Reading Challenges",
    prompt: "What challenges did you encounter when reading and analyzing literary masterpieces, and how did you overcome them?",
    answer: "The biggest challenge for me was dealing with unfamiliar historical backgrounds, long translated verses, and complex family lineages in epics like The Mahabharata and The Song of Roland. At first, it was easy to feel lost or overwhelmed. To overcome this, I changed my reading strategy. I started breaking readings down into smaller sections, keeping quick character notes, and discussing difficult chapters with classmates. Reading out loud also helped me catch the rhythm and emotion of the lines. Over time, what once felt intimidating became engaging, and I built the patience needed to tackle difficult texts on my own."
  },
  {
    topic: "Most Influential Critical Approach",
    prompt: "Which literary lens or approach influenced your interpretation of literature the most? Why?",
    answer: "The critical approach that influenced me the most was the Marxist and Socioeconomic lens, especially when we studied The Mahabharata. We are often taught to look at epic battles simply as conflicts between good heroes and bad villains. But looking through a socioeconomic lens helped me see how concentrated wealth, royal privilege, and land disputes actually drove the war. It opened my eyes to the fact that ordinary citizens and soldiers paid the heaviest price for decisions made by the royal elite. Applying this approach taught me to always question who holds power in a story and who carries the consequences."
  },
  {
    topic: "Realizations on Society & Human Nature",
    prompt: "What important realizations about life, society, culture, or human nature have you gained?",
    answer: "One of my biggest realizations is that unchecked pride and poor communication are two of the most destructive forces in human history. In The Iliad, Achilles' stubborn anger harms his own friends, and in The Panchatantra, toxic gossip destroys a loyal partnership between the lion and the bull. At the same time, stories like The Ramayana and The Odyssey reminded me that genuine resilience, empathy, and loyalty can carry people through the hardest trials. Technology and societies may evolve, but the core challenges of human nature remain remarkably consistent."
  },
  {
    topic: "Application to Personal & Professional Life",
    prompt: "How can you apply the lessons and values learned from Great Books in your personal, academic, or future professional life?",
    answer: "The lessons from Great Books give me practical guidance that I use in my everyday life and future career. Whenever I work in group projects, I remember how easily misunderstandings can ruin teamwork, so I prioritize clear communication, active listening, and keeping my ego in check. When facing academic stress or tight deadlines, Odysseus's perseverance reminds me to stay adaptable and calm instead of panicking. Most importantly, reading diverse stories across cultures taught me empathy, which helps me collaborate respectfully with people from all walks of life."
  }
];
---

<Layout 
  title="Learning Summary & Reflection | Great Books Portfolio"
  description="A unified synthesis combining core academic takeaways, critical lenses, and personal reading reflections across our Great Books journey."
>
  <div class="reflection-stage-wrapper">
    <!-- Full-Bleed Ambient Stage (Signature Book Cloth Crimson Backing) with Floating Reflection Emojis -->
    <div class="full-bleed-pixel-stage" aria-hidden="true">
      <div class="pixel-stage-vignette"></div>
      
      <!-- Floating Emojis relating to Reflection and Summary: 8 icons balanced 4 on each side -->
      <div class="floating-emojis-stage">
        <!-- 4 on Left Side -->
        <span class="floating-emoji float-left-1" title="Deep Contemplation">💭</span>
        <span class="floating-emoji float-left-2" title="Clarity & Illumination">🌟</span>
        <span class="floating-emoji float-left-3" title="Moral Compass">🧭</span>
        <span class="floating-emoji float-left-4" title="Intellectual Synthesis">🧠</span>

        <!-- 4 on Right Side -->
        <span class="floating-emoji float-right-1" title="Reflective Journaling">🖋️</span>
        <span class="floating-emoji float-right-2" title="Empathy & Compassion">🕊️</span>
        <span class="floating-emoji float-right-3" title="Enduring Wisdom">📖</span>
        <span class="floating-emoji float-right-4" title="Ethics & Human Nature">⚖️</span>
      </div>
    </div>

    <div class="page-header-block">
      <div class="container">
        <span class="section-tag">Synthesis & Reflection</span>
        <h1>Learning Summary & Reflection</h1>
        <p class="lead-text">
          A unified synthesis combining core academic takeaways, critical lenses, and personal reading reflections across our Great Books journey.
        </p>
      </div>
    </div>

    <div class="container container-reading combined-content-area">
      
      <!-- ========================================================
           PART I: Core Academic Takeaways & Learning Summary
           ======================================================== -->
      <section class="editorial-part">
        <div class="part-banner">
          <div class="part-title-group">
            <h2 class="part-title">Core Academic Takeaways</h2>
            <p class="part-subtitle">Key knowledge, cultural contexts, critical lenses, and interpretive skills developed in the course</p>
          </div>
        </div>

        <!-- Intro Card for Academic Takeaways -->
        <div class="summary-overview-card">
          <p class="overview-text">
            Throughout our study of the Great Books, literature served as more than just ancient stories, acting as an ongoing dialogue about the human condition. By engaging directly with diverse traditions and practicing varied critical lenses, we developed a deeper understanding of cultural heritage and strengthened our analytical abilities.
          </p>
        </div>

      <!-- 4 Core Pillars of Learning -->
      <div class="pillars-stack">
        {learningPillars.map((pillar) => (
          <article class="pillar-card">
            <div class="pillar-header">
              <h3 class="pillar-title">{pillar.title}</h3>
              <span class="pillar-subtitle">{pillar.subtitle}</span>
            </div>

            <p class="pillar-desc">{pillar.description}</p>

            <div class="takeaways-group">
              <h4 class="takeaways-label">Key Concepts:</h4>
              <ul class="takeaways-list">
                {pillar.keyTakeaways.map((takeaway) => (
                  <li>
                    <span class="takeaway-bullet">&bull;</span>
                    <span class="takeaway-text">{takeaway}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="synthesis-quote-box">
              <span class="synthesis-tag">Core Insight:</span>
              <p class="synthesis-text">{pillar.synthesis}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Decorative Section Divider -->
    <div class="section-divider" aria-hidden="true">
      <span class="divider-line"></span>
      <span class="divider-icon">&sect;</span>
      <span class="divider-line"></span>
    </div>

    <!-- ========================================================
         PART II: Personal Reflections & Reading Growth
         ======================================================== -->
    <section class="editorial-part">
      <div class="part-banner">
        <div class="part-title-group">
          <h2 class="part-title">Personal Reading Reflections</h2>
          <p class="part-subtitle">Reflective responses on reading challenges, intellectual growth, and lasting values</p>
        </div>
      </div>

      <!-- Intro Quote Card -->
      <div class="reflection-quote-card">
        <blockquote class="lead-quote">
          &ldquo;Reading literature is not just about analyzing words on a page; it is about discovering how stories from centuries ago still mirror who we are today.&rdquo;
        </blockquote>
        <span class="quote-caption">Reading & Philosophical Reflection</span>
      </div>

      <!-- 5 Personal Reflection Inquiries -->
      <div class="reflection-stack">
        {reflectionQuestions.map((item) => (
          <article class="reflection-entry-card">
            <header class="entry-header">
              <h3 class="entry-topic">{item.topic}</h3>
              <p class="entry-prompt">{item.prompt}</p>
            </header>

            <div class="entry-body">
              <p class="response-body">{item.answer}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Bottom Navigation Bar -->
    <nav class="reflection-bottom-nav">
      <a href="/favorite" class="btn btn-secondary">
        &larr; Favorite Masterpiece
      </a>
      <a href="/" class="btn btn-primary">
        Portfolio Home &rarr;
      </a>
    </nav>
  </div>
  </div>
</Layout>

<style>
  /* Reflection Stage Wrapper: strictly isolates the stage and clips fixed elements above footer */
  .reflection-stage-wrapper {
    position: relative;
    clip-path: inset(0 0 0 0);
    padding-bottom: 4rem;
  }

  /* Full-Bleed Ambient Stage (Signature Book Cloth Crimson Backing) */
  .full-bleed-pixel-stage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-accent); /* #881337 - signature crimson red */
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .pixel-stage-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 35%, rgba(76, 5, 25, 0.5) 100%);
  }

  /* Ambient Floating Emojis Layer: subtle background presence (4 left, 4 right) */
  .floating-emojis-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .floating-emoji {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    color: var(--color-bg);
    opacity: 0.22; /* Soft ambient opacity for true background feel */
    filter: grayscale(100%) brightness(0) invert(98%) sepia(12%) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    user-select: none;
    will-change: transform;
  }

  /* 4 on Left Side */
  .float-left-1 { top: 8%; left: 3.5%; animation: floatDrift 6.5s ease-in-out infinite alternate; }
  .float-left-2 { top: 32%; left: 4.5%; font-size: 2.45rem; animation: floatBob 5.8s ease-in-out infinite alternate; animation-delay: -1.2s; }
  .float-left-3 { top: 58%; left: 2.5%; font-size: 2.1rem; animation: floatTilt 7s ease-in-out infinite alternate; animation-delay: -2.5s; }
  .float-left-4 { bottom: 10%; left: 4%; font-size: 2.3rem; animation: floatDrift 6.2s ease-in-out infinite alternate; animation-delay: -1.8s; }

  /* 4 on Right Side */
  .float-right-1 { top: 12%; right: 3.5%; font-size: 2.5rem; animation: floatBob 5.5s ease-in-out infinite alternate; animation-delay: -0.8s; }
  .float-right-2 { top: 36%; right: 5%; font-size: 2.2rem; animation: floatTilt 6.8s ease-in-out infinite alternate; animation-delay: -2s; }
  .float-right-3 { top: 64%; right: 3%; font-size: 2.4rem; animation: floatDrift 6.4s ease-in-out infinite alternate; animation-delay: -3.2s; }
  .float-right-4 { bottom: 12%; right: 4.5%; font-size: 2.15rem; animation: floatBob 7.2s ease-in-out infinite alternate; animation-delay: -1.5s; }

  @keyframes floatBob {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-22px) rotate(4deg); }
    100% { transform: translateY(-8px) rotate(-3deg); }
  }

  @keyframes floatDrift {
    0% { transform: translate(0px, 0px) rotate(0deg); }
    50% { transform: translate(16px, -18px) rotate(-5deg); }
    100% { transform: translate(-10px, -10px) rotate(4deg); }
  }

  @keyframes floatTilt {
    0% { transform: translateY(0px) rotate(-3deg); }
    50% { transform: translateY(-24px) rotate(6deg); }
    100% { transform: translateY(-12px) rotate(-2deg); }
  }

  .page-header-block {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .combined-content-area {
    position: relative;
    z-index: 1;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .editorial-part {
    margin-bottom: 2rem;
  }

  /* Part Header Banners */
  .part-banner {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .part-badge {
    background: var(--color-accent);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    white-space: nowrap;
    margin-top: 0.2rem;
  }

  .part-title-group {
    flex-grow: 1;
  }

  .part-title {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.3rem;
    line-height: 1.25;
  }

  .part-subtitle {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Academic Summary Overview Card */
  .summary-overview-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem 2rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .overview-text {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }

  /* Pillars Stack */
  .pillars-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.25rem 2.25rem;
    box-shadow: var(--shadow-sm);
  }

  .pillar-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }

  .pillar-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }

  .pillar-subtitle {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .pillar-desc {
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  .takeaways-group {
    margin-bottom: 1.5rem;
  }

  .takeaways-label {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin: 0 0 0.85rem;
  }

  .takeaways-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .takeaways-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--color-text);
  }

  .takeaway-bullet {
    color: var(--color-accent);
    font-size: 1.1rem;
    line-height: 1;
  }

  .synthesis-quote-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 4px;
    padding: 1.15rem 1.35rem;
  }

  .synthesis-tag {
    display: block;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .synthesis-text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-primary);
    font-weight: 500;
  }

  /* Section Divider */
  .section-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin: 3.5rem 0;
  }

  .divider-line {
    flex-grow: 1;
    height: 1px;
    background: rgba(251, 250, 247, 0.45);
  }

  .divider-icon {
    font-size: 1.45rem;
    color: var(--color-bg); /* #fbfaf7 dirty white - contrasts cleanly against red background */
    font-family: var(--font-heading);
    opacity: 0.95;
  }

  /* Quote Card */
  .reflection-quote-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    padding: 2rem 2.25rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .lead-quote {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-style: italic;
    line-height: 1.75;
    color: var(--color-primary);
    margin: 0 0 0.85rem;
  }

  .quote-caption {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Reflection Prompts Stack */
  .reflection-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .reflection-entry-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .entry-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 2rem;
  }

  .entry-topic {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.35rem;
  }

  .entry-prompt {
    font-size: 0.94rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    font-style: italic;
  }

  .entry-body {
    padding: 1.75rem 2rem;
  }

  .response-body {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }

  /* Bottom Navigation */
  .reflection-bottom-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
    box-shadow: var(--shadow-sm);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
    border: 1px solid var(--color-primary);
  }

  .btn-primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .btn-secondary {
    background: #ffffff;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .floating-emoji {
      font-size: 1.5rem;
      opacity: 0.16;
    }
    .float-left-1 { top: 6%; left: 1.5%; }
    .float-left-2 { top: 28%; left: 2%; font-size: 1.6rem; }
    .float-left-3 { top: 54%; left: 1.5%; }
    .float-left-4 { bottom: 8%; left: 2%; }

    .float-right-1 { top: 10%; right: 1.5%; font-size: 1.6rem; }
    .float-right-2 { top: 34%; right: 2%; }
    .float-right-3 { top: 60%; right: 1.5%; font-size: 1.6rem; }
    .float-right-4 { bottom: 10%; right: 2%; }
  }

  @media (max-width: 680px) {
    .part-banner {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.25rem;
    }

    .pillar-card {
      padding: 1.5rem;
    }

    .entry-header, .entry-body {
      padding: 1.25rem;
    }

    .reflection-bottom-nav {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }
  }
</style>
