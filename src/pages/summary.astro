---
import Layout from '../layouts/Layout.astro';

const pillars = [
  {
    title: "Literary Masterpieces Across Eras & Cultures",
    subtitle: "Historical Periods & Cultural Trajectories",
    keyConcepts: [
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio. Praesent libero sed cursus ante dapibus diam.",
      "Sed nisi nulla, quis sem at nibh elementum imperdiet. Duis sagittis ipsum. Praesent mauris fusce nec tellus sed augue semper.",
      "Vestibulum lacinia arcu eget nulla. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos."
    ],
    synthesis: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip."
  },
  {
    title: "Application of Diverse Literary Lenses",
    subtitle: "Critical Hermeneutics & Theoretical Frameworks",
    keyConcepts: [
      "Curabitur sodales ligula in libero. Sed dignissim lacinia nunc. Curabitur tortor pellentesque nibh aenean quam.",
      "In hac habitasse platea dictumst. Vivamus adipiscing fermentum quam. Volutpat condimentum vitae, feugiat nec, diam.",
      "Morbi in sem quis dui placerat ornare. Pellentesque odio nisi, euismod in, pharetra a, ultricies in, diam. Sed arcu."
    ],
    synthesis: "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim."
  },
  {
    title: "Literature as a Reflection of Human Experience",
    subtitle: "Societal Conscience, Belief Systems & Shared Values",
    keyConcepts: [
      "Praesent dapibus, neque id cursus faucibus, tortor neque egestas augue, eu vulputate magna eros eu erat.",
      "Aliquam erat volutpat. Nam dui mi, tincidunt quis, accumsan porttitor, facilisis luctus, metus. Phasellus ultrices.",
      "Donec consectetuer ligula vulputate sem tristique cursus. Nam nulla quam, gravida non, commodo a, sodales sit amet."
    ],
    synthesis: "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae."
  },
  {
    title: "Development of Critical Thinking & Interpretation",
    subtitle: "Hermeneutic Precision & Analytical Close Reading",
    keyConcepts: [
      "Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores.",
      "Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed quia non numquam.",
      "Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit laboriosam, nisi ut aliquid ex ea commodi."
    ],
    synthesis: "At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate."
  }
];
---

<Layout 
  title="Learning Summary | Great Books Portfolio"
  description="Comprehensive summary of knowledge, concepts, and skills acquired throughout the Great Books curriculum."
>
  <div class="page-header-block">
    <div class="container">
      <span class="section-tag">Academic Synthesis</span>
      <h1>Learning Summary</h1>
      <p class="lead-text">
        A synthesis of key knowledge, historical contexts, critical lenses, and interpretive skills cultivated in Great Books.
      </p>
    </div>
  </div>

  <div class="container container-reading summary-content-area">
    <!-- Intro Statement -->
    <div class="summary-intro-card">
      <h2 class="intro-title">Core Dimensions of Learning</h2>
      <p class="intro-p">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus lacinia odio vitae vestibulum vestibulum. Cras venenatis euismod malesuada. Nulla facilisi. Praesent vulputate quam a nibh scelerisque, nec tincidunt dolor elementum.
      </p>
    </div>

    <!-- The 4 Topic Cards -->
    <div class="pillars-stack">
      {pillars.map((pillar) => (
        <section class="pillar-card">
          <div class="pillar-header">
            <h3 class="pillar-title">{pillar.title}</h3>
            <span class="pillar-subtitle">{pillar.subtitle}</span>
          </div>

          <div class="pillar-body">
            <h4 class="concepts-heading">Key Concepts:</h4>
            <ul class="concepts-list">
              {pillar.keyConcepts.map((concept) => (
                <li>
                  <span class="bullet">&bull;</span>
                  <span>{concept}</span>
                </li>
              ))}
            </ul>

            <div class="synthesis-box">
              <span class="synthesis-label">Key Insight:</span>
              <p class="synthesis-text">{pillar.synthesis}</p>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Next Section Navigation -->
    <div class="next-step-bar">
      <span>Continue reading:</span>
      <a href="/reflection" class="btn btn-primary">
        Personal Reflection &rarr;
      </a>
    </div>
  </div>
</Layout>

<style>
  .summary-content-area {
    padding-bottom: 3.5rem;
  }

  .summary-intro-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem 2.25rem;
    margin-bottom: 2.5rem;
  }

  .intro-title {
    font-size: 1.45rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .intro-p {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .pillars-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem 2.25rem;
  }

  .pillar-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }

  .pillar-title {
    font-size: 1.35rem;
    margin: 0 0 0.25rem;
    color: var(--color-primary);
  }

  .pillar-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .concepts-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.85rem;
  }

  .concepts-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .concepts-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-text);
  }

  .bullet {
    color: var(--color-accent);
    font-size: 1.2rem;
    line-height: 1;
  }

  .synthesis-box {
    background: var(--color-bg);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 4px 4px 0;
    padding: 1rem 1.25rem;
  }

  .synthesis-label {
    display: block;
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .synthesis-text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text);
  }

  .next-step-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.75rem;
  }

  .next-step-bar span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--color-accent);
  }

  @media (max-width: 680px) {
    .pillar-card {
      padding: 1.5rem;
    }
  }
</style>
